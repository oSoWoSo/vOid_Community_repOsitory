diff --git a/CMakeLists.txt b/CMakeLists.txt
new file mode 100644
index 0000000..47920ce
--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,170 @@
+cmake_minimum_required(VERSION 3.16)
+
+project(QRunsvMgr VERSION 0.2.6 LANGUAGES CXX)
+
+set(CMAKE_CXX_STANDARD 17)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+
+add_compile_options(-Wall -Wextra -pedantic)
+set(CMAKE_AUTOMOC ON)
+
+set(SRC_DIR ${CMAKE_SOURCE_DIR}/src)
+
+option(BUILD_QT_GUI "Build the Qt GUI (qrunsvmgr-qt)" ON)
+option(BUILD_RUNIT_HELPER "Build runit service helper" ON)
+option(BUILD_DINIT_HELPER "Build dinit service helper" OFF)
+option(BUILD_S6_HELPER "Build s6 service helper" OFF)
+
+find_package(Qt6 REQUIRED COMPONENTS Core Widgets Network)
+find_package(PkgConfig REQUIRED)
+
+if(BUILD_DINIT_HELPER)
+	pkg_check_modules(DINITCTL REQUIRED libdinitctl)
+endif()
+
+qt_standard_project_setup()
+
+configure_file(
+	${SRC_DIR}/Version.h.in
+	${CMAKE_BINARY_DIR}/Version.h
+	@ONLY
+)
+
+if(BUILD_QT_GUI)
+	add_executable(qrunsvmgr-qt
+		${SRC_DIR}/main.cpp
+		${SRC_DIR}/MainWindow.h
+		${SRC_DIR}/MainWindow.cpp
+		${SRC_DIR}/ServiceItem.h
+		${SRC_DIR}/ServiceItem.cpp
+		${SRC_DIR}/ConfigDialog.h
+		${SRC_DIR}/ConfigDialog.cpp
+		${SRC_DIR}/Settings.h
+		${SRC_DIR}/Settings.cpp
+	)
+
+	target_link_libraries(qrunsvmgr-qt PRIVATE
+		Qt6::Core
+		Qt6::Widgets
+		Qt6::Network
+	)
+
+	target_include_directories(qrunsvmgr-qt PRIVATE
+		${CMAKE_BINARY_DIR}
+		${SRC_DIR}
+	)
+
+	message(STATUS "Building Qt GUI: qrunsvmgr-qt")
+endif()
+
+if(BUILD_RUNIT_HELPER)
+	add_executable(qrunsvmgr-helper-runit
+		${SRC_DIR}/helpers/ServiceHelper-runit.cpp
+	)
+
+	target_link_libraries(qrunsvmgr-helper-runit PRIVATE
+		Qt6::Core
+		Qt6::Network
+	)
+
+	set_target_properties(qrunsvmgr-helper-runit
+		PROPERTIES OUTPUT_NAME "qrunsvmgr-helper-runit"
+	)
+
+	message(STATUS "Building runit helper")
+endif()
+
+if(BUILD_DINIT_HELPER)
+	add_executable(qrunsvmgr-helper-dinit
+		${SRC_DIR}/helpers/ServiceHelper-dinit.cpp
+	)
+
+	target_link_libraries(qrunsvmgr-helper-dinit PRIVATE
+		Qt6::Core
+		Qt6::Network
+		${DINITCTL_LIBRARIES}
+	)
+
+	target_include_directories(qrunsvmgr-helper-dinit PRIVATE
+		${DINITCTL_INCLUDE_DIRS}
+	)
+
+	target_compile_options(qrunsvmgr-helper-dinit PRIVATE
+		${DINITCTL_CFLAGS_OTHER}
+	)
+
+	set_target_properties(qrunsvmgr-helper-dinit
+		PROPERTIES OUTPUT_NAME "qrunsvmgr-helper-dinit"
+	)
+
+	message(STATUS "Building dinit helper")
+endif()
+
+if(BUILD_S6_HELPER)
+	add_executable(qrunsvmgr-helper-s6
+		${SRC_DIR}/helpers/ServiceHelper-s6.cpp
+	)
+
+	target_link_libraries(qrunsvmgr-helper-s6 PRIVATE
+		Qt6::Core
+		Qt6::Network
+	)
+
+	set_target_properties(qrunsvmgr-helper-s6
+		PROPERTIES OUTPUT_NAME "qrunsvmgr-helper-s6"
+	)
+
+	message(STATUS "Building s6 helper")
+endif()
+
+configure_file(
+	${SRC_DIR}/qrunsvmgr
+	${CMAKE_BINARY_DIR}/qrunsvmgr
+	COPYONLY
+)
+
+set(INSTALL_TARGETS)
+
+if(BUILD_QT_GUI)
+	list(APPEND INSTALL_TARGETS qrunsvmgr-qt)
+endif()
+
+if(BUILD_RUNIT_HELPER)
+	list(APPEND INSTALL_TARGETS qrunsvmgr-helper-runit)
+endif()
+
+if(BUILD_DINIT_HELPER)
+	list(APPEND INSTALL_TARGETS qrunsvmgr-helper-dinit)
+endif()
+
+if(BUILD_S6_HELPER)
+	list(APPEND INSTALL_TARGETS qrunsvmgr-helper-s6)
+endif()
+
+install(TARGETS ${INSTALL_TARGETS}
+	RUNTIME DESTINATION bin
+)
+
+install(FILES ${SRC_DIR}/qrunsvmgr
+	DESTINATION bin
+	PERMISSIONS
+		OWNER_EXECUTE OWNER_WRITE OWNER_READ
+		GROUP_EXECUTE GROUP_READ
+		WORLD_EXECUTE WORLD_READ
+)
+
+install(FILES ${SRC_DIR}/qrunsvmgr.desktop
+	DESTINATION share/applications
+	PERMISSIONS
+		OWNER_READ OWNER_WRITE OWNER_EXECUTE
+		GROUP_READ GROUP_EXECUTE
+		WORLD_READ WORLD_EXECUTE
+)
+
+if(BUILD_QT_GUI)
+	add_custom_target(run
+		COMMAND ./qrunsvmgr --runit
+		DEPENDS qrunsvmgr-qt
+		WORKING_DIRECTORY ${CMAKE_BINARY_DIR}
+	)
+endif()
\ No newline at end of file
diff --git a/README.md b/README.md
index 08307e7..daac549 100644
--- a/README.md
+++ b/README.md
@@ -4,7 +4,6 @@
 
 `qrunsvmgr` is a lightweight graphical interface for managing system services. It provides a simple way to start, stop, and monitor your system services.
 
-
 ## Features:
 
 - [x] Start, stop, and restart services
@@ -16,21 +15,21 @@
 - [x] View services status
 - [x] Different backends
 
-## Building
+## Build and use
+
+<details>
 
 ```
 git clone https://codeberg.org/itszariep/qrunsvmgr
-cd qrunsvmgr/src
+cd qrunsvmgr
 ```
+
 ```
-mkdir build
-cd build
+mkdir -B build
 ```
+
 ```
-cmake ..
-```
-```
-cmake --build .
+cmake --build build
 ```
 
  You will have: `qrunsvmgr-qt`, `qrunsvmgr-helper-runit`/`qrunsvmgr-helper-dinit` and `qrunsvgr`. use the last for easily launching the program, with --{init} as argument, for example:
@@ -43,6 +42,11 @@ cmake --build .
  qrunsvmgr --dinit
  ```
  
+> [!NOTE]  
+>  Since i cannot reliable get the current init or user setup, if you want to use the menu entry, you should patch the qrunsvmgr.desktop file (it defaults to `--runit`)
+
+</details>
+
 ## Backends
 
 Originally, QRunsvMgr was going to be exclusively for `runit`, however, due to the IPC structure I created, I realized that I could make the backend run in a different way and the GUI would still be compatible.
