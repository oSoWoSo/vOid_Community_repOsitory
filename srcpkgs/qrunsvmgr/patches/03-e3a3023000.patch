 #include <unistd.h>
 #include <sys/stat.h>
 
+QString ServiceItem::serviceSocketPath()
+{
+	QString tempPath =
+	QStandardPaths::writableLocation(QStandardPaths::TempLocation);
+
+	if (tempPath.isEmpty())
+	{
+		tempPath = QDir::tempPath();
+	}
+
+	return QDir(tempPath).filePath("qrunsvmgr.sock");
+}
