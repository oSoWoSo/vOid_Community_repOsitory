Use the system libheif and libjpeg-turbo instead of building vendored copies.
With both crates off cmake, the cmake binary is no longer needed at all.

--- a/Cargo.toml
+++ b/Cargo.toml
@@ -41,7 +41,6 @@
 ] }
 kamadak-exif = "0.6.1"
 libheif-rs = { version = "2.7.0", default-features = false, features = [
-  "embedded-libheif",
   "v1_17",
 ] }
 lru = "0.16.3"
@@ -51,7 +50,9 @@
 thiserror = "2.0.18"
 tokio = { version = "1.49.0", features = ["rt-multi-thread", "sync", "fs"] }
 tracing = "0.1.44"
-turbojpeg = "1.4.0"
+turbojpeg = { version = "1.4.0", default-features = false, features = [
+  "pkg-config",
+] }
 zune-image = "0.5.0"
 
 
