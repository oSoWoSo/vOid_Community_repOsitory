# Template file for 'DankMaterialShell'
pkgname=DankMaterialShell
version=1.6.2
revision=2
_version=1.6.0
build_style=gnu-makefile
build_helper=qemu
make_build_args="VERSION=${version} COMMIT=2db7646fe3ab47fddfdb8723f2da07d61a0d47ac"
hostmakedepends="go tar"
short_desc="Desktop shell for wayland compositors built with Quickshell & GO"
maintainer="zenobit <zen@osowoso.org>"
license="MIT"
homepage="https://github.com/AvengeMedia/DankMaterialShell"
distfiles="https://github.com/AvengeMedia/DankMaterialShell/archive/refs/tags/v${version}.tar.gz
 https://github.com/AvengeMedia/dank-qml-common/archive/refs/tags/v${_version}.tar.gz"
checksum="5eff09d35d39b18f9d593f0f464e2fb5be3ddf6c92fa9eb1e99c534126c62419
 1d2a7820054ed7efdcf3bffe4ba611a37c2e701844de575a168cece66f57027e"

post_extract() {
	mv ${pkgname}-${version}/* ./
	mv dank-qml-common-${_version}/* dank-qml-common/
}

pre_build() {
	case "${XBPS_TARGET_MACHINE}" in
		aarch64*) export GOARCH=arm64 ;;
		armv5*) export GOARCH=arm; export GOARM=5 ;;
		armv6*) export GOARCH=arm; export GOARM=6 ;;
		armv7*) export GOARCH=arm; export GOARM=7 ;;
		i686*) export GOARCH=386 ;;
		x86_64*) export GOARCH=amd64 ;;
		ppc64le*) export GOARCH=ppc64le ;;
		ppc64*) export GOARCH=ppc64 ;;
		riscv64*) export GOARCH=riscv64 ;;
		*) broken="DankMaterialShell: unsupported architecture: ${XBPS_TARGET_MACHINE}" ;;
	esac
	export GOOS=linux
	export CGO_ENABLED=0
	export GOTOOLCHAIN=local
	export GOPATH="${XBPS_HOSTDIR}/gopath"
	export GOCACHE="${XBPS_HOSTDIR}/gocache-${XBPS_TARGET_MACHINE}"
}

do_check() {
	echo "In next version"
	#make test-qml
}

do_install() {
	make STRIP=true PREFIX=/usr prefix=/usr DESTDIR="${DESTDIR}" \
		install-bin install-icon install-desktop
	vlicense LICENSE
}

post_install() {
	vinstall assets/systemd/dms.service 644 usr/lib/systemd/user
	for shell in bash zsh fish; do
		vtargetrun ${DESTDIR}/usr/bin/dms completion ${shell} >dms.${shell}
		vcompletion dms.${shell} ${shell} dms
	done
}
