# Template file for 'cosmic-applets'
pkgname=cosmic-applets
version=1.9.0
revision=1
archs="x86_64*"
build_style=cargo
hostmakedepends="pkg-config just"
makedepends="libxkbcommon-devel eudev-libudev-devel dbus-devel pulseaudio-devel libinput-devel"
short_desc="Applets for COSMIC Panel"
maintainer="zenobit <zen@osowoso.org>"
license="GPL-3.0-only"
homepage="https://github.com/pop-os/cosmic-applets"
distfiles="https://github.com/pop-os/cosmic-applets/archive/refs/tags/epoch-${version}.tar.gz"
checksum=f113f74cd05b179ab0478dd5876b671880914600d5df56d518f8f80c08543037

do_install() {
	just --set targetdir "target/${RUST_TARGET}" --set rootdir ${DESTDIR} \
		--set prefix /usr --set cosmic-applets-bin cosmic-applets install
}
