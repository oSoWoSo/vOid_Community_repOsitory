# Template file for 'flyline'
pkgname=flyline
version=1.9.0
revision=1
build_style=cargo
hostmakedepends="pkg-config"
depends="bash"
short_desc="Bash plugin to replace readline for a modern line editing experience"
maintainer="zenobit <zen@osowoso.org>"
license="GPL-3.0-only, MIT"
homepage="https://github.com/HalFrgrd/flyline"
distfiles="https://github.com/HalFrgrd/flyline/archive/refs/tags/v${version}.tar.gz"
checksum=7d0af846bbfaa48f4ebe3c78f24135f3a6298990cd98903c39601be89e510b71
pre_check() {
	# Remove failing tests
	rm tests/docker_integration_tests.rs
	echo -e "\n\nDocker integration tests removed\n\n"
}

do_install() {
	vinstall target/${RUST_TARGET}/release/libflyline.so 755 usr/lib/bash
}

post_install() {
	vdoc README.md
	vlicense LICENSE-MIT
}
