# Template file for 'brave-browser-bin'
pkgname=brave-browser-bin
version=1.93.138
revision=1
archs="x86_64 aarch64"
hostmakedepends="rpmextract"
short_desc="One of the most private browsers built on top off Chromium project"
maintainer="zenobit <zen@osowoso.org>"
license="MPL-2.0"
homepage="https://www.brave.com/"
changelog="https://raw.githubusercontent.com/brave/brave-browser/refs/heads/master/CHANGELOG_DESKTOP.md"
distfiles="https://github.com/brave/brave-browser/releases/download/v${version}/brave-browser-${version}-1.x86_64.rpm
 https://github.com/brave/brave-browser/releases/download/v${version}/brave-browser-${version}-1.aarch64.rpm"
checksum="2e4c19300339d0c5dd73841c5ee441c643e981a0f8ab892582929ee87769801d
 59265b70746ba09a91cbf5dcdfc2e542286e03bf01192509d152dfa30593c098"
replaces="brave-browser-arm-bin>=0"

do_extract() {
	local archiv
	case "$XBPS_TARGET_MACHINE" in
		x86_64) archiv="brave-browser-${version}-1.x86_64.rpm" ;;
		aarch64) archiv="brave-browser-${version}-1.aarch64.rpm" ;;
	esac
	vextract "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${archiv}"
}

do_install() {
	rm -f etc/cron.daily/brave-browser
	vcopy * /
	for size in 16 24 32 48 64 128 256; do
		vmkdir usr/share/icons/hicolor/${size}x${size}/apps
		vcopy opt/brave.com/brave/product_logo_${size}.png usr/share/icons/hicolor/${size}x${size}/apps/brave-browser.png
	done
}
