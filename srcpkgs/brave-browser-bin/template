# Template file for 'brave-browser-bin'
pkgname=brave-browser-bin
version=1.96.60
revision=1
archs="x86_64 aarch64"
hostmakedepends="unzip"
depends="desktop-file-utils hicolor-icon-theme hwids xdg-utils"
short_desc="One of the most private browsers built on top off Chromium project"
maintainer="zenobit <zen@osowoso.org>"
license="MPL-2.0"
homepage="https://www.brave.com/"
changelog="https://raw.githubusercontent.com/brave/brave-browser/refs/heads/master/CHANGELOG_DESKTOP.md"
distfiles="https://github.com/brave/brave-browser/releases/download/v${version}/brave-browser-${version}-linux-amd64.zip
 https://github.com/brave/brave-browser/releases/download/v${version}/brave-browser-${version}-linux-arm64.zip"
checksum="c3d073309ff6ef7d02b4b5cf40ac43e6544f5c4966fbb1673cf55fbdd12fea55
 fc25ee62d7de63eb1ce5793cfe3b2aca24f84c979069fd1a4dcf6fabcce72750"
replaces="brave-browser-arm-bin>=0"
skip_extraction=yes
repository=nonfree
restricted=yes
nostrip=yes
nopie=yes
noshlibprovides=yes

do_extract() {
	case "$XBPS_TARGET_MACHINE" in
		x86_64)
			archiv="brave-browser-${version}-linux-amd64.zip"
			;;
		aarch64)
			archiv="brave-browser-${version}-linux-arm64.zip"
			;;
	esac
	unzip ${XBPS_SRCDISTDIR}/${pkgname}-${version}/${archiv}
}

do_install() {
	vbin ${FILESDIR}/brave
	vlicense LICENSE

	vmkdir opt/brave
	for f in brave \
		brave-browser \
		chrome-management-service \
		chrome-sandbox \
		chrome_crashpad_handler \
		brave_100_percent.pak \
		brave_200_percent.pak \
		brave_resources.pak \
		chrome_100_percent.pak \
		chrome_200_percent.pak \
		default-app-block \
		icudtl.dat \
		libqt5_shim.so \
		libqt6_shim.so \
		libvk_swiftshader.so \
		libvulkan.so.1 \
		resources.pak \
		v8_context_snapshot.bin \
		vk_swiftshader_icd.json \
		MEIPreload \
		PrivacySandboxAttestationsPreloaded \
		resources \
		apparmor.d \
		locales; do
			vcopy "$f" opt/brave
	done

	chmod 755 "${DESTDIR}/opt/brave/brave"
	chmod 755 "${DESTDIR}/opt/brave/brave-browser"
	chmod 755 "${DESTDIR}/opt/brave/chrome-sandbox"
	chmod 755 "${DESTDIR}/opt/brave/chrome_crashpad_handler"
	chmod 755 "${DESTDIR}/opt/brave/chrome-management-service"

	for size in 16 24 32 48 64 128 256; do
		vinstall product_logo_${size}.png 644 \
			usr/share/icons/hicolor/${size}x${size}/apps brave-browser.png
	done

	vinstall ${FILESDIR}/brave-browser.desktop 644 usr/share/applications
}

brave-browser-bin-qt5_package() {
	short_desc+=" - Qt5 integration shim"
	pkg_install() {
		vmove opt/brave/libqt5_shim.so
	}
}

brave-browser-bin-qt6_package() {
	short_desc+=" - Qt6 integration shim"
	pkg_install() {
		vmove opt/brave/libqt6_shim.so
	}
}
