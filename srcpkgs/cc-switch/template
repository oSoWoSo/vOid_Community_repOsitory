# Template file for 'cc-switch'
pkgname=cc-switch
version=3.15.0
revision=2
archs="x86_64* aarch64*"
hostmakedepends="nodejs cargo python3 xdg-utils pnpm pkg-config"
makedepends="glib-devel cairo-devel gdk-pixbuf-devel gtk+3-devel pango-devel libwebkit2gtk41-devel libsoup3-devel libsecret-devel openssl-devel rust-std"
depends="glib cairo gdk-pixbuf gtk+3 pango libwebkit2gtk41 libsoup3 libsecret openssl"
short_desc="Assistant for Claude Code, Codex, OpenCode, OpenClaw & Gemini CLI"
maintainer="zenobit <zen@osowoso.org>"
license="MIT"
homepage="https://github.com/farion1231/cc-switch"
distfiles="https://github.com/farion1231/cc-switch/archive/refs/tags/v${version}.tar.gz"
checksum=fc5fa3941dff278d61dd2e48c5c005508fb31beedc506e37a9306be024ef651b

_setup_env() {
	if [ -n "$CROSS_BUILD" ]; then
		export CARGO_BUILD_TARGET="$RUST_TARGET"
		export PKG_CONFIG_ALLOW_CROSS=1
		export BINDGEN_EXTRA_CLANG_ARGS+=" --sysroot=${XBPS_CROSS_BASE}"
		export CFLAGS_${RUST_BUILD//-/_}="${CFLAGS_host}" \
		 CXXFLAGS_${RUST_BUILD//-/_}="${CXXFLAGS_host}" \
		 LDFLAGS_${RUST_BUILD//-/_}="${LDFLAGS_host}" \
		 CFLAGS_${RUST_TARGET//-/_}="${CFLAGS}" \
		 CXXFLAGS_${RUST_TARGET//-/_}="${CXXFLAGS}" \
		 LDFLAGS_${RUST_TARGET//-/_}="${LDFLAGS}" \
		 CFLAGS="" CXXFLAGS="" LDFLAGS=""
	fi
}

pre_build() {
	rm -f pnpm-lock.yaml
	pnpm install --ignore-scripts
	if [ -n "$CROSS_BUILD" ]; then
		_setup_env
		cargo fetch --locked --target ${RUST_TARGET} --manifest-path src-tauri/Cargo.toml
	fi
}

do_build() {
	if [ -n "$CROSS_BUILD" ]; then
		_setup_env
		pnpm run build:renderer
		cargo build --release --locked --target ${RUST_TARGET} --manifest-path src-tauri/Cargo.toml
	else
		pnpm tauri build --no-bundle --ci
	fi
}

do_check() {
	pnpm run test:unit || true
}

do_install() {
	for size in 32x32 128x128 256x256; do
		vmkdir usr/share/icons/hicolor/${size}/apps
		vinstall src-tauri/icons/${size}.png 644 usr/share/icons/hicolor/${size}/apps com.ccswitch.desktop.png
	done
	vmkdir usr/share/applications
	vinstall flatpak/com.ccswitch.desktop.desktop 644 usr/share/applications com.ccswitch.desktop.desktop

	local _targetpath="src-tauri/target"
	if [ -n "$CROSS_BUILD" ]; then
		_targetpath="${_targetpath}/${RUST_TARGET}"
	fi
	vbin ${_targetpath}/release/cc-switch
	vlicense LICENSE
}
