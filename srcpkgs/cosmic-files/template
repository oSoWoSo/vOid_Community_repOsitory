# Template file for 'cosmic-files'
pkgname=cosmic-files
version=1.9.0
revision=1
archs="x86_64*"
build_style=cargo
hostmakedepends="pkg-config just"
makedepends="libxkbcommon-devel libglib-devel"
depends="cosmic-icons gvfs xdg-utils"
short_desc="File manager for the COSMIC desktop environment"
maintainer="zenobit <zen@osowoso.org>"
license="GPL-3.0-only"
homepage="https://github.com/pop-os/cosmic-files"
distfiles="https://github.com/pop-os/cosmic-files/archive/refs/tags/epoch-${version}.tar.gz"
checksum=c30cb40b8177112c821753a95134ba82e64dfd8230f5c371a1c89a4b0d066309

do_build() {
	just build-release
}

do_install() {
	just install
}

post_install() {
	vbin target/release/cosmic-files
	vbin target/release/cosmic-files-thumbnailer
	vbin target/release/cosmic-files-applet
	vinstall target/xdgen/com.system76.CosmicFiles.metainfo.xml 644 usr/share/metainfo
	vinstall target/xdgen/com.system76.CosmicFiles.desktop 644 usr/share/applications
	for size in 16 24 32 48 64 128 256; do
		vinstall res/icons/hicolor/${size}x${size}/apps/com.system76.CosmicFiles.svg \
		 644 usr/share/icons/hicolor/${size}x${size}/apps/com.system76.CosmicFiles.svg
	done
}
