# Template file for 'mesa-amber'
pkgname=mesa-amber
version=26.1.2
revision=1
build_style=meson
build_helper="qemu"
_llvmver=21
configure_args="-Dglvnd=enabled -Dgbm=enabled -Degl=enabled
 -Dgles1=enabled -Dgles2=enabled -Dglx=dri
 -Dlmsensors=enabled -Dplatforms=x11,wayland
 -Dllvm=enabled -Db_lto=false -Dcpp_std=gnu++17
 -Dglvnd-vendor-name=amber -Dvideo-codecs=all"
hostmakedepends="gettext flex pkg-config python3-Mako glslang
 llvm${_llvmver} wayland-protocols wayland-devel python3-pycparser python3-yaml
 clang${_llvmver}"
makedepends="elfutils-devel expat-devel libXdamage-devel
 libXxf86vm-devel libdrm-devel libffi-devel libva-devel libdisplay-info
 libxshmfence-devel ncurses-devel zlib-devel
 wayland-devel wayland-protocols llvm${_llvmver}-devel libsensors-devel
 libXrandr-devel libglvnd-devel libzstd-devel libxml2-devel lua54-devel
 libarchive-devel libXext-devel libpng-devel
 SPIRV-LLVM-Translator${_llvmver}-devel SPIRV-Tools-devel
 llvm${_llvmver}"
depends="libglvnd"
short_desc="Mesa for older hardware (legacy driver build)"
maintainer="Bella109 <belladev109@proton.me>"
license="MIT, LGPL-2.1-or-later"
homepage="https://www.mesa3d.org/"
changelog="https://docs.mesa3d.org/relnotes.html"
distfiles="https://mesa3d.org/archive/mesa-${version}.tar.xz"
checksum=bac2bca9121897a2b8162e79636b50ac998fca799c8e6cf914edd85962babdf0
conflicts="mesa"

# only use llvmpipe on targets where it's supported and reliable
case "$XBPS_TARGET_MACHINE" in
	i686*|x86_64*|aarch64*|ppc64le*|arm*|riscv64*)
		_have_llvmpipe=yes
		;;
esac

# Driver configuration
_gallium_drivers=" -Dgallium-drivers=softpipe"
_vulkan_drivers=" -Dvulkan-drivers="

case "$XBPS_TARGET_MACHINE" in
	armv5*|mips*) ;;
	*)
		_have_nv=yes
		_have_amd=yes
		_have_virgl=yes
		;;
esac

case "$XBPS_TARGET_MACHINE" in
	i686*|x86_64*)
		_have_intel=yes
		_have_vmware=yes
		;;
	armv[67]*|aarch64*)
		_have_arm=yes
		;;
esac

if [ "$_have_llvmpipe" ]; then
	_vulkan_drivers+=",swrast"
else
	configure_args+=" -Ddraw-use-llvm=false"
fi

if [ "$_have_amd" ]; then
	_have_opencl=yes
	_gallium_drivers+=",r300,r600,radeonsi"
	_vulkan_drivers+=",amd"
	hostmakedepends+=" clang${_llvmver}"
	makedepends+=" libclc${_llvmver}"
fi

if [ "$_have_intel" ]; then
	_gallium_drivers+=",crocus,iris,i915"
	_vulkan_drivers+=",intel,intel_hasvk"
	case "$XBPS_TARGET_MACHINE" in
	x86_64*) configure_args+=" -Dintel-rt=enabled" ;;
	esac
fi

if [ "$_have_nv" ]; then
	_gallium_drivers+=",nouveau"
	# NVK (nouveau vulkan) needs Rust crate vendoring; skip for now
fi

if [ "$_have_arm" ]; then
	_gallium_drivers+=",v3d,vc4,freedreno,etnaviv,lima,panfrost,asahi"
	_vulkan_drivers+=",broadcom,freedreno,panfrost,asahi"
fi

if [ "$_have_virgl" ]; then
	_gallium_drivers+=",virgl"
	_vulkan_drivers+=",virtio"
fi

if [ "$_have_vmware" ]; then
	_gallium_drivers+=",svga"
fi

# Disable Rusticl in cross builds due to duplicate --sysroot
if [ "$_have_opencl" ] && [ -z "$CROSS_BUILD" ]; then
	hostmakedepends+=" rust rust-bindgen"
	makedepends+=" rust"
	configure_args+=" -Dgallium-rusticl=true -Drust_std=2021"
fi

configure_args+=" -Dgallium-va=enabled"

_vulkan_drivers=${_vulkan_drivers/=,/=}

configure_args+=" ${_vulkan_drivers}"
configure_args+=" ${_gallium_drivers}"

case "$XBPS_TARGET_MACHINE" in
	ppc64le*) configure_args+=" -Dpower8=true" ;;
	ppc*) configure_args+=" -Dpower8=false" ;;
esac

pre_configure() {
	if [ "$CROSS_BUILD" ] && [ "$_have_opencl" ]; then
		export PKG_CONFIG_PATH="${XBPS_CROSS_BASE}/usr/lib/llvm/${_llvmver}/share/pkgconfig"
	fi
}

post_install() {
	vlicense docs/license.rst
}
