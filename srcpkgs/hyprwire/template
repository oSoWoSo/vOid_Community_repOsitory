# Template file for 'hyprwire'
pkgname=hyprwire
version=0.3.1
revision=2
build_style=cmake
configure_args="--no-warn-unused-cli -DCMAKE_BUILD_TYPE:STRING=Release \
 -DCMAKE_INSTALL_PREFIX:PATH=/usr -DBUILD_TESTING:BOOL=OFF"
hostmakedepends="pkg-config pugixml-devel"
makedepends="hyprutils-devel libffi-devel pugixml-devel"
short_desc="Fast and consistent wire protocol for IPC"
maintainer="zenobit <zen@osowoso.org>"
license="BSD-3-Clause"
homepage="https://github.com/hyprwm/hyprwire"
distfiles="https://github.com/hyprwm/hyprwire/archive/refs/tags/v${version}.tar.gz"
checksum=92a673d40ae6a7d66fbcd0a34ec071e026e17eaeeb0040c3375e4b2a80dba737

post_install() {
	vlicense LICENSE
}

hyprwire-devel_package() {
	short_desc+=" - development files"
	depends="${sourcepkg}>=${version}_${revision}"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
		vmove usr/lib/*.so
		vmove usr/lib/cmake
		vmove usr/bin/hyprwire-scanner
	}
}
