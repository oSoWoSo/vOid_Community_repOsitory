# Template file for 'xxtools-git'
pkgname=xxtools-git
version=0.0.0
revision=1
build_style=gnu-makefile
short_desc="Tools to ease packaging tasks for Void Linux"
maintainer="zenobit <zen@osowoso.org>"
license="0BSD"
homepage="https://github.com/Piraty/xxtools"
