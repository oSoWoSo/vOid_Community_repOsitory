# Template file for 'Community-Repositories-Collection'
pkgname=Community-Repositories-Collection
version=1
revision=8
metapackage=yes
short_desc="CRC: Collection of community repositories"
maintainer="zenobit <zen@osowoso.org>"
license="Public Domain"
homepage="https://repo.osowoso.org"

CRC-black-hole_package() {
	archs="x86_64*"
	short_desc="${short_desc} - blackhole repository"
	homepage="https://github.com/Event-Horizon-VL/blackhole-vl"
	pkg_install() {
		vmkdir etc/xbps.d
		echo "repository=https://mirror.black-hole.dev/${XBPS_TARGET_MACHINE}" > \
			${PKGDESTDIR}/etc/xbps.d/20-CRC-black-hole.conf
	}
}

