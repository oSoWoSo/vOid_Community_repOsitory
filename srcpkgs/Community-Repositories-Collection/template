CRC-d77void_package() {
	archs="x86_64*"
	short_desc="${short_desc} - d77 Void repository"
	homepage="https://github.com/d77void/srcpkgs-d77"
	pkg_install() {
		vmkdir etc/xbps.d
		repo="https://sourceforge.net/projects/d77void/files/"
		case "${XBPS_TARGET_MACHINE}" in
			x86_64) repo+="d77void-repo" ;;
			x86_64-musl) repo+="d77void-musl" ;;
		esac
		echo "repository=${repo}" > ${PKGDESTDIR}/etc/xbps.d/20-CRC-d77void.conf
	}
}

CRC-hyprland_package() {
	archs="x86_64* aarch64*"
	short_desc="${short_desc} - Hyprland repository by sofijacom"
	homepage="https://github.com/sofijacom/hyprland-void"
	pkg_install() {
		vmkdir etc/xbps.d
		repo="https://raw.githubusercontent.com/sofijacom/hyprland-void/repository-"
		case "${XBPS_TARGET_MACHINE}" in
			x86_64) repo+="x86_64-glibc" ;;
			x86_64-musl) repo+="x86_64-musl" ;;
			aarch64) repo+="aarch64-glibc" ;;
			aarch64-musl) repo+="aarch64-musl" ;;
		esac
		echo "repository=${repo}" > ${PKGDESTDIR}/etc/xbps.d/20-CRC-hyprland.conf
	}
}

