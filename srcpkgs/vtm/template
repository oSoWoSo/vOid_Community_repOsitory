pre_configure() {
	if [ -n "$XBPS_CROSS_BUILD" ]; then
		export STB_INCLUDE_DIR=/usr/${XBPS_CROSS_TRIPLET}/usr/include/stb
	else
		export STB_INCLUDE_DIR=/usr/include/stb
	fi
}

post_install() {
	vlicense LICENSE
}
