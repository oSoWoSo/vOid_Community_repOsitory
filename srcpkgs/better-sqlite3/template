# Template file for 'better-sqlite3'
pkgname=better-sqlite3
version=13.0.3
revision=1
hostmakedepends="nodejs nodejs-devel python3"
depends="nodejs"
short_desc="Fastest and simplest SQLite library for Node.js"
maintainer="zenobit <zenobit@disroot.org>"
license="MIT"
homepage="https://github.com/WiseLibs/better-sqlite3"
distfiles="https://github.com/WiseLibs/better-sqlite3/archive/refs/tags/v${version}.tar.gz"
checksum=12128e2c669e276084961ec12a03e1986110fa2936927384c8c273c1fb7607ff
python_version=3
nocross="node-gyp has no target node headers available when cross building"

export npm_config_audit=false
export npm_config_fund=false
export npm_config_loglevel=error
export npm_config_update_notifier=false

do_configure() {
	# npm insists on a writable HOME for its cache
	export HOME="${WRKDIR}/.home"
	export npm_config_cache="${HOME}/.npm"
	mkdir -p ${HOME}

	# use the headers of the nodejs we are building against
	export npm_config_nodedir=/usr
}

do_build() {
	# --ignore-scripts: npm would run "node-gyp rebuild" on its own here,
	# without npm_config_nodedir, and we do want node-addon-api for the include
	# path that binding.gyp asks for
	npm install --ignore-scripts

	local _gyp
	_gyp="$(npm root -g)/npm/node_modules/node-gyp/bin/node-gyp.js"

	# we always want the source build
	node ${_gyp} rebuild --release --force_build=1
}

do_check() {
	npm test
}

do_install() {
	local _dest="usr/lib/node_modules/${pkgname}"

	npm prune --omit=dev

	vmkdir ${_dest}
	vcopy lib ${_dest}
	vcopy package.json ${_dest}

	# lib/binding.js looks for exactly this path
	vmkdir ${_dest}/build/Release
	vinstall build/Release/better_sqlite3.node 644 ${_dest}/build/Release

	vlicense LICENSE
}
