# Template file for 'librewolf-bin'
pkgname=librewolf-bin
version=154.0.1.3
revision=1
archs="x86_64 aarch64"
short_desc="Community-maintained fork of Firefox focused on privacy and security"
maintainer="zenobit <zen@osowoso.org>"
license="MPL-2.0"
homepage="https://librewolf.net"
distfiles="https://dl.librewolf.net/librewolf/${version%.*}-${version##*.}/librewolf-${version%.*}-${version##*.}-linux-x86_64-package.tar.xz
 https://dl.librewolf.net/librewolf/${version%.*}-${version##*.}/librewolf-${version%.*}-${version##*.}-linux-arm64-package.tar.xz"
checksum="413a71164ace86ceeaa426568b3196fe9fda823f873a106803e075dc4dbfdf5f
 d318652b32166ff2b13cfd2756c6be3a2f962dcee835d2678a1f07dc7654de12"
conflicts="librewolf"
shlib_provides="libonnxruntime.so.1"
nostrip=yes

do_extract() {
	local archiv
	case "$XBPS_TARGET_MACHINE" in
		x86_64) archiv="librewolf-${version%.*}-${version##*.}-linux-x86_64-package.tar.xz" ;;
		aarch64) archiv="librewolf-${version%.*}-${version##*.}-linux-arm64-package.tar.xz" ;;
	esac
	vextract "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${archiv}"
}

do_install() {
	vmkdir usr/lib/librewolf
	vcopy "*" usr/lib/librewolf
	vmkdir usr/share/applications
	vcopy "${FILESDIR}/librewolf.desktop" usr/share/applications
	vinstall browser/chrome/icons/default/default128.png 644 usr/share/pixmaps librewolf.png
	vbin "${FILESDIR}/librewolf"
}
