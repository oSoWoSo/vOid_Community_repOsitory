build_style=cmake
pycompile_dirs="usr/share/${pkgname}/settings-gui"
configure_args="-DLOTUS_UINPUT_PROXY_USER=_uinput_proxy -DINSTALL_RUNIT=ON -DRUNIT_SV_DIR=/usr/share/examples/sv -DLOTUS_BYTECOMPILE_PYTHON=OFF"
hostmakedepends="extra-cmake-modules pkg-config gettext go python3 librsvg-utils"
makedepends="libfcitx5-devel libinput-devel eudev-libudev-devel acl-devel libX11-devel"
depends="fcitx5 acl acl-progs"
checkdepends="fcitx5 iso-codes xkeyboard-config"
short_desc="Fcitx5 - Vietnamese IME"
maintainer="Coolllyn <leanhduc673@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/LotusInputMethod/fcitx5-lotus"
distfiles="https://github.com/LotusInputMethod/fcitx5-lotus/archive/refs/tags/v${version}.tar.gz>fcitx5-lotus-${version}.tar.gz
 https://github.com/LotusInputMethod/bamboo-core/archive/${_bamboo_commit}.tar.gz>bamboo-core-${_bamboo_commit}.tar.gz"
checksum="0b499e12b83660a576f5042f4fef43608e332fc312076fc1251648e5c89811ba
 83a094caa4ba0db1abb1842d727233ae921c20aed85956bc14850bbff63d803c"
python_version=3
skip_extraction="bamboo-core-${_bamboo_commit}.tar.gz"

system_accounts="_uinput_proxy"
_uinput_proxy_groups="input"

if [ -n "$XBPS_CHECK_PKGS" ]; then
	configure_args+=" -DBUILD_TESTING=ON"
else
	configure_args+=" -DBUILD_TESTING=OFF"
fi

post_extract() {
	vsrcextract -C bamboo/bamboo-core "bamboo-core-${_bamboo_commit}.tar.gz"
}

pre_build() {
	export CGO_ENABLED=1
	if [ "$CROSS_BUILD" ]; then
		case "$XBPS_TARGET_MACHINE" in
			aarch64*) export GOARCH=arm64 ;;
			armv6l*)  export GOARCH=arm; export GOARM=6 ;;
			armv7l*)  export GOARCH=arm; export GOARM=7 ;;
			i686*)    export GOARCH=386 ;;
			x86_64*)  export GOARCH=amd64 ;;
		esac
	fi
}

do_check() {
	# The headless integration tests build a real LotusEngine, whose Go core
	# silently returns a null handle when the Vietnamese dictionary is missing
	# via fcitx5 StandardPaths (PkgData: lotus/vietnamese.cm.dict). That file
	# is only placed after installation (upstream CI runs 'cmake --install'
	# before ctest), so expose it from the source tree through a temporary
	# XDG_DATA_DIRS entry. Without this every key event is silently dropped
	# and 5 integration tests fail with "key was not accepted".
	local _lotus_share="${wrksrc}/.lotus-check/share"
	mkdir -p "${_lotus_share}/fcitx5/lotus"
	cp "${wrksrc}/data/dictionaries/vietnamese.cm.dict" \
		"${_lotus_share}/fcitx5/lotus/"

	XDG_DATA_DIRS="${_lotus_share}:/usr/local/share:/usr/share" \
		 ctest --test-dir "${wrksrc}/${cmake_builddir:-build}" --output-on-failure
}

fcitx5-lotus-settings_package() {
	short_desc+=" - Settings"
	depends="fcitx5-lotus python3 python3-QtPy python3-pyqt6 python3-dbus python3-pyqt6-widgets python3-pyqt6-gui qt6-wayland"
	pkg_install() {
		vmove usr/bin/fcitx5-lotus-settings
		vmove usr/share/fcitx5-lotus/settings-gui
		vmove usr/share/applications/org.fcitx.Fcitx5.Addon.Lotus.Settings.desktop
	}
}
