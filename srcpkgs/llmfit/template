# Template file for 'llmfit'
pkgname=llmfit
version=1.1.10
revision=1
build_style=cargo
build_wrksrc="llmfit-tui"
make_install_args="--force"
hostmakedepends="nodejs"
short_desc="Hundreds of models & providers, easy to find what fits your hardware"
maintainer="zenobit <zenobit@disroot.org>"
