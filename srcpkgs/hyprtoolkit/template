# Template file for 'hyprtoolkit'
pkgname=hyprtoolkit
version=0.6.0
revision=2
build_style=cmake
configure_args="--no-warn-unused-cli -DDISABLE_TESTS=ON -DCMAKE_BUILD_TYPE:STRING=Release"
hostmakedepends="pkg-config hyprwayland-scanner hicolor-icon-theme"
makedepends="aquamarine-devel cairo-devel hyprgraphics hyprlang hyprutils-devel
 iniparser-devel libdrm-devel libgbm-devel libglvnd-devel libxkbcommon-devel
 pango-devel pixman-devel wayland-devel wayland-protocols abseil-cpp-devel"
depends="wayland"
short_desc="Modern C++ Wayland-native GUI toolkit"
maintainer="zenobit <zen@osowoso.org>"
license="BSD-3-Clause"
homepage="https://github.com/hyprwm/hyprtoolkit"
distfiles="https://github.com/hyprwm/hyprtoolkit/archive/refs/tags/v${version}.tar.gz"
checksum=53c41be72af97d9ede274a63c9c1034c58726d862905763ed6e5a564ae42ba6b
make_check=no # cant run in sandbox

post_install() {
	vlicense LICENSE
}

hyprtoolkit-devel_package() {
	short_desc+=" - development files"
	depends="${sourcepkg}>=${version}_${revision} wayland-devel wayland-protocols libglvnd-devel"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
	}
}
