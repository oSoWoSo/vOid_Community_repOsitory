# Template file for 'pop-launcher'
# build/install commands adapted from Arch Linux PKGBUILD
pkgname=pop-launcher
version=1.9.0
revision=1
archs="x86_64*"
build_style=cargo
hostmakedepends="pkg-config just clang lld"
makedepends="libxkbcommon-devel libqalculate-devel"
depends="fd bash xdg-utils"
short_desc="Modular IPC-based desktop launcher service"
maintainer="zenobit <zen@osowoso.org>"
license="MPL-2.0, GPL-3.0-only"
homepage="https://github.com/pop-os/launcher"
distfiles="https://github.com/pop-os/launcher/archive/refs/tags/epoch-${version}.tar.gz"
checksum=86907d81d7a97938076455be3b9e4f093fb90760a95c1e0558a04350e5701fb5

do_build() {
	export RUSTFLAGS="${RUSTFLAGS} -C link-arg=-fuse-ld=lld"
	CC=clang just build-release --locked
}

do_install() {
	just rootdir="${DESTDIR}" install
}
