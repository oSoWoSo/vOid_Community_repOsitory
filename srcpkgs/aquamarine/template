# Template file for 'aquamarine'
pkgname=aquamarine
version=0.15.1
revision=2
build_style=cmake
configure_args="--no-warn-unused-cli -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX:PATH=/usr"
hostmakedepends="pkg-config hyprwayland-scanner"
makedepends="hwids hyprutils-devel hyprwayland-scanner libdisplay-info-devel
 libdrm-devel libgbm-devel libglvnd-devel libinput-devel libseat-devel
 libudev-devel pixman-devel wayland-devel wayland-protocols"
short_desc="Aquamarine is a very light linux rendering backend library"
maintainer="zenobit <zen@osowoso.org>"
license="BSD-3-Clause"
homepage="https://github.com/hyprwm/aquamarine"
changelog="https://github.com/hyprwm/aquamarine/releases"
distfiles="https://github.com/hyprwm/aquamarine/archive/refs/tags/v${version}.tar.gz"
checksum=2f9de98c0bd1b7b1b09c576e390a2fef436449762fb334163c414f0c300296f2
make_check=no # cant run in sandbox

post_install() {
	vlicense LICENSE
}

aquamarine-devel_package() {
	depends="aquamarine-${version}_${revision}"
	short_desc+=" - development files"

	pkg_install() {
		vmove usr/include
		vmove "usr/lib/*.so"
		vmove usr/lib/pkgconfig
	}
}
