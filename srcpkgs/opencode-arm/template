# Template file for 'opencode-arm'
pkgname=opencode-arm
version=1.15.6
revision=1
archs="aarch64*"
hostmakedepends="bun-bin-arm nodejs python3 git"
depends="ripgrep"
short_desc="Open source AI coding agent"
maintainer="zenobit <zen@osowoso.org>"
license="MIT"
homepage="https://github.com/anomalyco/opencode"
distfiles="https://github.com/anomalyco/opencode/archive/refs/tags/v${version}.tar.gz"
checksum=566a034e8af1c273395ee1ae8898a7f453b07297da1c4bfc246df7619ca6249f
# TODO: create update script (Ignore 0. ... versions) same as opencode template
nostrip_files="/usr/bin/opencode"
nopie_files="/usr/bin/opencode"

do_build() {
	export OPENCODE_VERSION="${version}"

	bun install --frozen-lockfile
	bun run --cwd packages/opencode build -- --single --skip-install
}

do_install() {
	vbin packages/opencode/dist/opencode-linux-aarch64/bin/opencode
	vlicense LICENSE

	$DESTDIR/usr/bin/opencode completion > opencode
	vcompletion opencode bash
}
