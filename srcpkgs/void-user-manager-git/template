# Template file for 'void-user-manager-git'
pkgname=void-user-manager-git
version=0.0.0
revision=1
archs="x86_64"
depends="gtk4 libadwaita polkit"
short_desc="Modern, lightweight user and service management application"
maintainer="zenobit <zen@osowoso.org>"
license="GPL-2.0-only"
homepage="https://codeberg.org/pinguin-void/void-user-manager"
