checksum=b94ddd220f0a72bc9e604866092e91a2197653f46f4682410aca4f4851a0054e

do_install() {
	vmkdir usr/share/applications
	vcopy "${FILESDIR}/void-user-manager.desktop" usr/share/applications

	vmkdir usr/share/icons
	vcopy user.png usr/share/icons

	vbin void-user-manager
}
