desc_option_yt="Enable YouTube, SoundCloud, Bandcamp, Bilibili, NetEase Cloud Music support"

post_install() {
	vlicense LICENSE
	vdoc README.md
	for doc in docs/*; do
		vdoc "$doc"
	done
}
