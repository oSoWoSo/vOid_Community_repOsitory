# Template file for 'waterfox-bin'
pkgname=waterfox-bin
version=6.7.1.1
revision=1
archs="x86_64 aarch64"
short_desc="Fast and private web browser"
maintainer="zenobit <zen@osowoso.org>"
license="MPL-2.0"
homepage="https://www.waterfox.net"
changelog="https://www.waterfox.net/docs/releases/${version}/"
distfiles="https://cdn.waterfox.com/waterfox/releases/${version}/Linux_x86_64/waterfox-${version}.tar.bz2>waterfox-${version}-x64.tar.bz2
 https://cdn.waterfox.com/waterfox/releases/${version}/Linux_aarch64/waterfox-${version}.tar.bz2>waterfox-${version}-arm64.tar.bz2"
checksum="7892826dc1df4d4dcb1bff5b526d20bb31f42e90dcd9d4aea2884e595941c1de
 ab7fe14c8e3915a7a0dee78ce73d08a28c2d07c2e7caee1c74ff1f0a06d39e2a"
nopie=yes

do_extract() {
	case "$XBPS_TARGET_MACHINE" in
		x86_64) a="x64" ;;
		aarch64) a="arm64" ;;
	esac
	vextract "${XBPS_SRCDISTDIR}/${pkgname}-${version}/waterfox-${version}-${a}.tar.bz2"
}

do_install() {
	vmkdir opt/waterfox
	vcopy * opt/waterfox
	vbin ${FILESDIR}/waterfox
	vinstall "${FILESDIR}/waterfox.desktop" 0644 usr/share/applications
	for res in 16 32 48 64 128; do
		vmkdir usr/share/icons/hicolor/${res}x${res}/apps
		ln -rfs "${DESTDIR}/opt/waterfox/browser/chrome/icons/default/default${res}.png" \
			"${DESTDIR}/usr/share/icons/hicolor/${res}x${res}/apps/waterfox.png"
	done
	vinstall "${FILESDIR}/vendor.js" 644 opt/waterfox/browser/defaults/preferences
	vinstall "${FILESDIR}/policies.json" 644 opt/waterfox/distribution
}
