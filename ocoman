# --- Update ---

list_templates() {
	sed -n 's/^!\/srcpkgs\/\([^/]*\)[/]*$/\1/p' "${SCRIPT_DIR}/.gitignore" | sort -fu
}

generate_list() {
	_gitignore="${SCRIPT_DIR}/.gitignore"

	_new_pkgs=$(for _entry in "${SCRIPT_DIR}/${SRCPKGS}"/*/; do
		[ -d "$_entry" ] || [ -L "$_entry" ] || continue
		_pkg=${_entry%/}; _pkg=${_pkg##*/}
		echo "$_pkg"
	done | sort -f)

	_tmp=$(mktemp)
	awk '/^# Start of templates list$/{print; exit} {print}' "$_gitignore" > "$_tmp"
	printf '%s\n' "$_new_pkgs" | sed '/^$/d; s|^|!/srcpkgs/|' >> "$_tmp"

	if diff -q "$_gitignore" "$_tmp" >/dev/null 2>&1; then
		echo '.gitignore templates: no changes'
		rm -f "$_tmp"
	else
		mv "$_tmp" "$_gitignore"
		echo '.gitignore templates: updated'
	fi

	list_templates > "$TEMPLATES_LIST"
	echo 'Templates list synchronized from .gitignore'
}

generate_readme() {
	_tmp=$(mktemp)

	awk '/^## Available/{exit} {print}' "$README" > "$_tmp"

	{
		echo '## Available templates (packages when built successfully)'
		echo '| package | version | home | maintainer | notes | description |'
		echo '|:--------|:--------|:-----|:-----------|:------|:------|'
		while IFS= read -r _pkg; do
			_tpl="$SRCPKGS/$_pkg/template"
			[ -f "$_tpl" ] || continue
			read_template_fields "$_tpl"

			_home=''
			[ -n "$_tpl_homepage" ] && _home="[home](${_tpl_homepage})"

			echo "| $_pkg | $_tpl_version | $_home | $_tpl_maintainer | $_tpl_archs | $_tpl_short_desc |"
		done < "$TEMPLATES_LIST"
	} >> "$_tmp"

	mv "$_tmp" "$README"
	echo 'README: updated'
}

generate_build_yml() {
	[ -f "$BUILD_TEMPLATE" ] || fatal "not found: ${BUILD_TEMPLATE}"
	[ -f "$TEMPLATES_LIST" ] || fatal "not found: ${TEMPLATES_LIST}"

	mkdir -p "$(dirname "$WORKFLOW")"

	_opts=$(mktemp)
	while IFS= read -r _pkg; do
		[ -z "$_pkg" ] && continue
		printf '        - %s\n' "$_pkg"
	done < "$TEMPLATES_LIST" > "$_opts"

	awk -v opts="$_opts" '
		/^[[:space:]]*__TEMPLATE_OPTIONS__[[:space:]]*$/ {
			while ((getline ln < opts) > 0) print ln
			close(opts)
			next
		}
		{ print }
	' "$BUILD_TEMPLATE" > "$WORKFLOW"

	rm -f "$_opts"
	echo 'build.yml: updated'
}

detect_changes() {
	if ! git rev-parse HEAD~1 >/dev/null 2>&1; then
		echo '==> First commit'
		_added=$(cat "$TEMPLATES_LIST")
		_modified=''
		_removed=''
	else
		_diff=$(git diff --name-status HEAD~1 HEAD -- "$SRCPKGS")
		_added=$(   echo "$_diff" | awk '$1=="A"{print $2}' | cut -d/ -f2 | sort -u)
		_modified=$(echo "$_diff" | awk '$1=="M"{print $2}' | cut -d/ -f2 | sort -u)
		_removed=$( echo "$_diff" | awk '$1=="D"{print $2}' | cut -d/ -f2 | sort -u)
	fi

	_added=$(echo "$_added"     | sed '/^$/d')
	_modified=$(echo "$_modified" | sed '/^$/d')
	_removed=$(echo "$_removed"   | sed '/^$/d')

	echo "==> Added:   $(echo "$_added" | tr '\n' ' ')"
	echo "==> Modified: $(echo "$_modified" | tr '\n' ' ')"
	echo "==> Removed: $(echo "$_removed" | tr '\n' ' ')"
}

# --- RSS feed (feed.opml) suggestions ---

feed_xml_escape() {
	printf '%s' "$1" |
		sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g; s/"/\&quot;/g'
}

# Usage: feed_urls_from_nvchecker <pkg>
# Derives upstream RSS/HTML urls from .nvchecker/nvchecker.toml section
# [<pkg>] (source=github|gitea|gitlab). Handles quoted section names
# (["llama.cpp"]) and `${pkgname}` placeholders.
# Sets _feed_xml_url _feed_html_url; returns 0 when derivable, 1 otherwise.
feed_urls_from_nvchecker() {
	_feed_xml_url='' _feed_html_url=''
	_fun_pkg="$1"
	[ -f "$NVCONF" ] || return 1

	_fun_tmp=$(awk '
		$0 ~ /^\[/ {
			s=$0; sub(/^\[/, "", s); sub(/\]$/, "", s); gsub(/"/, "", s)
			insec = (s == pkg); next
		}
		insec && NF >= 3 {
			if ($1 == "source") src = $3
			else if ($1 == "github") repo = $3
			else if ($1 == "gitea") repo = $3
			else if ($1 == "gitlab") repo = $3
			else if ($1 == "host") host = $3
		}
		END { print src; print repo; print host }
	' pkg="$_fun_pkg" "$NVCONF")

	# Note: in awk, $3 of 'host = "x"' is the field AFTER '='; but for
	# 'source = "x"' the value is also $3. So all values are $3 above.
	_fun_src=$(echo "$_fun_tmp" | sed -n '1p' | tr -d '"')
	_fun_repo=$(echo "$_fun_tmp" | sed -n '2p' | tr -d '"')
	_fun_host=$(echo "$_fun_tmp" | sed -n '3p' | tr -d '"')

	case "$_fun_repo" in
		*'${pkgname}'*)
			_fun_repo=$(printf '%s' "$_fun_repo" |
				sed "s/\${pkgname}/${_fun_pkg}/g")
			;;
	esac

	case "$_fun_src" in
		github | gitea | gitlab) ;;
		*) return 1 ;;
	esac
	[ -n "$_fun_repo" ] || return 1

	case "$_fun_src" in
		github)
			_feed_xml_url="https://github.com/${_fun_repo}/tags.atom"
			_feed_html_url="https://github.com/${_fun_repo}/releases"
			;;
		gitea)
			_fun_host=${_fun_host:-codeberg.org}
			_feed_xml_url="https://${_fun_host}/${_fun_repo}/tags.rss"
			_feed_html_url="https://${_fun_host}/${_fun_repo}/tags"
			;;
		gitlab)
			_fun_host=${_fun_host:-gitlab.com}
			_feed_xml_url="https://${_fun_host}/${_fun_repo}/-/tags?format=atom"
			_feed_html_url="https://${_fun_host}/${_fun_repo}/-/tags"
			;;
	esac
	return 0
}

# Usage: feed_urls_from_homepage <url>
# Fallback: derive urls from a homepage pointing at a well-known host
# (github.com / codeberg.org / gitlab.com). Keeps subgroup-style paths
# (gitlab.com/group/sub/project).
# Sets _feed_xml_url _feed_html_url; returns 0 on success, 1 otherwise.
feed_urls_from_homepage() {
	_feed_xml_url='' _feed_html_url=''
	_fun_hp="$1"
	_fun_host=''
	_fun_path=''
	case "$_fun_hp" in
		https://github.com/*) _fun_host=github.com; _fun_path=${_fun_hp#https://github.com/} ;;
		https://codeberg.org/*) _fun_host=codeberg.org; _fun_path=${_fun_hp#https://codeberg.org/} ;;
		https://gitlab.com/*) _fun_host=gitlab.com; _fun_path=${_fun_hp#https://gitlab.com/} ;;
		*) return 1 ;;
	esac
	_fun_path=${_fun_path%%\?*}
	_fun_path=${_fun_path%%\#*}
	[ -n "$_fun_path" ] || return 1

	case "$_fun_host" in
		github.com)
			_feed_xml_url="https://github.com/${_fun_path}/tags.atom"
			_feed_html_url="https://github.com/${_fun_path}/releases"
			;;
		codeberg.org)
			_feed_xml_url="https://codeberg.org/${_fun_path}/tags.rss"
			_feed_html_url="https://codeberg.org/${_fun_path}/tags"
			;;
		gitlab.com)
			_feed_xml_url="https://gitlab.com/${_fun_path}/-/tags?format=atom"
			_feed_html_url="https://gitlab.com/${_fun_path}/-/tags"
			;;
	esac
	return 0
}

# Usage: feed_opml_has <pkg>
# Returns 0 when an <outline> with title="<pkg>" exists under the
# package-update folder of src/feed.opml, 1 otherwise (also when the
# file is missing).
feed_opml_has() {
	_fun_pkg="$1"
	[ -f "$FEED_OPML" ] || return 1
	awk -v p="$_fun_pkg" '
		/<outline text="package-update">/ { sec = 1; next }
		sec && /<outline/ && index($0, "title=\"" p "\"") { found = 1 }
		END { exit (found ? 0 : 1) }
	' "$FEED_OPML"
	return $?
}

# Suggest missing feed.opml <outline> entries for templates that were
# added or modified. Prints draft lines to stdout only when src/feed.opml
# exists (i.e. local runs; CI checkout has no feed.opml -> silent skip).
# Subpackage symlinks and already-present packages are skipped.
suggest_feeds() {
	[ -f "$FEED_OPML" ] || return 0
	_feed_pkgs=$(printf '%s\n' "$_added $_modified" | tr ' ' '\n' |
		sed '/^$/d' | sort -fu | tr '\n' ' ')
	[ -n "$_feed_pkgs" ] || return 0

	_feed_out=''
	for _pkg in $_feed_pkgs; do
		[ -L "${SRCPKGS}/$_pkg" ] && continue
		feed_opml_has "$_pkg" && continue
		[ -f "${SRCPKGS}/$_pkg/template" ] || continue
		read_template_fields "${SRCPKGS}/$_pkg/template"

		feed_urls_from_nvchecker "$_pkg"
		if [ $? -ne 0 ]; then
			feed_urls_from_homepage "$_tpl_homepage"
		fi

		_title=$(feed_xml_escape "$_pkg")
		_desc=$(feed_xml_escape "$_tpl_short_desc")

		if [ -n "$_feed_xml_url" ]; then
			_feed_line="    <outline title=\"${_title}\" text=\"${_title}\" xmlUrl=\"${_feed_xml_url}\" htmlUrl=\"${_feed_html_url}\" description=\"${_desc}\" type=\"rss\"></outline>"
		else
			_feed_line="    # ${_pkg}: upstream feed nelze odvodit (zadna nvchecker sekce / homepage neni hosting) -- pridej rucne"
		fi
		_feed_out="$_feed_out
$_feed_line"
	done

	[ -n "$_feed_out" ] || return 0
	echo '==> RSS feed (feed.opml) proposals:'
	echo '    (vlozit do <outline text="package-update">):'
	echo "$_feed_out"
}

# --- Web ---

generate_arch_pages() {
	_template="${SCRIPT_DIR}/src/arch-index-template.html"
	[ -f "$_template" ] || fatal "arch-index-template.html not found!"

	_pkg_list=$(list_templates)

	for _arch in $ARCHES; do
		[ -z "${ARCH:-}" ] || [ "$_arch" = "$ARCH" ] || continue
		_out_dir="${SCRIPT_DIR}/docs/${_arch}"
		_out="${_out_dir}/index.html"
		_repo_url="${SURFER_URL}/${_arch}"

		mkdir -p "$_out_dir"

		_nav_tmp=$(mktemp)
		_pkg_tmp=$(mktemp)
		_svg_tmp=$(mktemp)

		for _a in $ARCHES; do
			if [ "$_a" = "$_arch" ]; then
				printf '  <li><a href="." class="active">%s</a></li>\n' "$_arch" >> "$_nav_tmp"
			else
				printf '  <li><a href="../%s/">%s</a></li>\n' "$_a" "$_a" >> "$_nav_tmp"
			fi
		done

		# Determine which packages are actually PUBLISHED for this arch.
		# Source of truth: the public URL (repo.osowoso.org/${arch}/),
		# read via `list_published_pkgs` which prefers xbps-query and
		# falls back to fetching+parsing the repodata.
		#
		# _have_remote=1: authoritative listing (even if empty) -- pages
		# show only the intersection of srcpkgs and what's published.
		# _have_remote='':  listing unavailable -- fall back to showing
		# every compatible template, with a warning.
		_have_remote=''
		_remote_names=''
		_lpf=$(mktemp)
		# Capture list_published_pkgs's exit BEFORE the pipe to sort,
		# otherwise sort's success would mask a transport/parse failure.
		if list_published_pkgs "$_arch" > "$_lpf"; then
			_have_remote=1
			_remote_names=$(sort -u "$_lpf")
		else
			_y "Warning: could not list published packages for ${_arch}; rendering full template list"
		fi
		rm -f "$_lpf"

		{
			printf '<table>\n<thead><tr>\n'
			printf '  <th>package</th><th>version</th><th>homepage</th><th>maintainer</th><th>description</th>\n'
			printf '</tr></thead>\n<tbody>\n'

			_pkg_count=0
			for _pkg in $_pkg_list; do
				pkg_arch_ok "$_pkg" "$_arch" || continue
				_tpl="${SRCPKGS}/${_pkg}/template"
				[ -f "$_tpl" ] || continue

				if [ "$_have_remote" = 1 ]; then
					printf '%s\n' "$_remote_names" | grep -qx "$_pkg" || continue
				fi

				read_template_fields "$_tpl"

				printf '<tr><td><strong>%s</strong></td><td>%s</td><td><a href="%s">%s</a></td><td>%s</td><td>%s</td></tr>\n' \
					"$_pkg" "$_tpl_version" "$_tpl_homepage" "$_tpl_homepage" "$_tpl_maintainer" "$_tpl_short_desc"
				_pkg_count=$((_pkg_count + 1))
			done

			printf '</tbody>\n</table>\n'
		} > "$_pkg_tmp"

		cp "${SCRIPT_DIR}/src/svg-color.html" "$_svg_tmp" 2>/dev/null || touch "$_svg_tmp"

		sed \
			-e "s|__ARCH__|${_arch}|g" \
			-e 's|__CSS_URL__|../style.css|g' \
			-e 's|__HOME_URL__|../index.html|g' \
			-e "s|__REPO_URL__|${_repo_url}|g" \
			-e "s|__GIT_CI_URL__|${CI_URL}|g" \
			-e 's|__FAVICON__|<link rel="icon" href="../favicon.ico" />|g' \
			"$_template" \
		| awk \
			-v nav="$_nav_tmp" \
			-v tbl="$_pkg_tmp" \
			-v svg="$_svg_tmp" \
			'/__NAV_ARCH_LINKS__/ { while ((getline ln < nav) > 0) print ln; close(nav); next }
			 /__PACKAGE_TABLE__/  { while ((getline ln < tbl) > 0) print ln; close(tbl); next }
			 /__SVGCOLOR__/       { while ((getline ln < svg) > 0) print ln; close(svg); next }
			 { print }' \
		> "$_out"

		rm -f "$_nav_tmp" "$_pkg_tmp" "$_svg_tmp"
		echo "  Generated ($_pkg_count packages): docs/${_arch}/index.html"

		if surf_auth_check; then
			_webdav_arch="${SURFER_URL}/_webdav/${_arch}"
			surf_mkcol "${_webdav_arch}/" || true
			if ! upload_file "$_out" "${_webdav_arch}/index.html"; then
				fatal "Failed to upload ${_arch}/index.html!"
			fi
		fi
	done
}

build_site() {
	_title="${1:-Void Community Repository}"

	if ! command -v pandoc >/dev/null 2>&1; then
		fatal 'pandoc not installed!'
	fi

	if [ -f docs/CNAME ]; then
		cp docs/CNAME src/
	fi
	rm -rf docs && mkdir -p docs
	cp -r src/* docs/
	rm -f docs/toggle.html docs/toc.html docs/svg-color.html docs/footer.html

	_build_main_index "$_title"
	generate_arch_pages
	_g "Finished"

	if surf_auth_check; then
		_webdav="${SURFER_URL}/_webdav"
		echo '==> Uploading website assets'
