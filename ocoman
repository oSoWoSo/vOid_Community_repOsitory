SHLIBS_REMOVE="${SCRIPT_DIR}/shlibs_remove"

# --- UI helpers (ANSI) ---

if [ -z "$NO_COLOR" ]; then
	RED=$(printf '\033[0;31m')
	GREEN=$(printf '\033[0;32m')
	YELLOW=$(printf '\033[1;33m')
	BLUE=$(printf '\033[0;34m')
	NC=$(printf '\033[0m')
fi
_r() {
	echo "${RED}${*}${NC}"
}
_g() {
	echo "${GREEN}${1}${NC}"
}
_b() {
	echo "${BLUE}${1}${NC}"
}
_y() {
	echo "${YELLOW}${1}${NC}"
}
ask() {
	printf '%s%s [Y/n] %s' "$YELLOW" "$1" "$NC"
	read -r _ans || _ans=y
	case "$_ans" in [Nn]*) return 1 ;; *) return 0 ;; esac
}

# --- Core helpers ---

fatal() {
	_r '[FATAL]:' "$@" >&2
	exit 1
}

_re() {
	fatal "${RED}${*}${NC}"
}

# --- Surfer (WebDAV) helpers ---

# curl with Surfer credentials. Surfer >= 7.0 requires a username plus a
# Cloudron app password, so the user may never be left empty.
surf_curl() {
	# A package upload may legitimately run for minutes; a blanket --max-time
	# would truncate it mid-PUT and leave a corrupt .xbps on the server, so
	# only non-upload requests get a hard cap.
	case " $* " in
		*' -T '* | *' --upload-file '*)
			curl -u "${SURFER_USER}:${SURFER_TOKEN}" \
				--connect-timeout "$SURF_CONNECT_TIMEOUT" "$@"
			;;
		*)
			curl -u "${SURFER_USER}:${SURFER_TOKEN}" \
				--connect-timeout "$SURF_CONNECT_TIMEOUT" \
				--max-time "$SURF_MAX_TIME" "$@"
			;;
	esac
}

# Classify why a Surfer request failed, by probing the site root.
# Returns: 0 reachable, 1 host down/unhealthy, 2 auth rejected (terminal).
surf_diagnose() {
	_sd_body=$(mktemp)
	_sd_code=$(surf_curl -s -o "$_sd_body" -w '%{http_code}' "${SURFER_URL}/" 2>/dev/null) || _sd_code=0
	case "$_sd_code" in
		401 | 403)
			rm -f "$_sd_body"
			echo "::error::Surfer rejected our credentials (HTTP ${_sd_code}); check SURFER_USER/SURFER_TOKEN" >&2
			return 2
			;;
		200 | 30[0-9])
			rm -f "$_sd_body"
			return 0
			;;
	esac
	# Cloudron serves an HTML error page (HTTP 502) while the app restarts.
	if grep -qiE 'app is not responding|Cloudron App Error' "$_sd_body" 2>/dev/null; then
		rm -f "$_sd_body"
		echo "::error::Surfer app is DOWN (${SURFER_URL}/ -> HTTP ${_sd_code}, Cloudron \"app is not responding\")." >&2
		echo "::error::If uploads keep failing, check whether Surfer crashed -- host 'docker logs' for 'getChildPath'." >&2
		return 1
	fi
	rm -f "$_sd_body"
	echo "::error::Surfer host unreachable or unhealthy (${SURFER_URL}/ -> HTTP ${_sd_code:-000})" >&2
	return 1
}

# Shared retry driver: run "$@" until it succeeds or the SURF_DEADLINE
# wall-clock budget is spent. A fixed attempt count cannot cover a host that
# is down for a quarter of an hour, so the budget is the contract.
surf_retry_loop() {
	_srl_start=$(date +%s)
	_srl_delay="$SURF_BACKOFF"
	_srl_n=0
	_srl_probed=0
	while :; do
		_srl_n=$((_srl_n + 1))
		"$@" && return 0
		_srl_now=$(date +%s)
		_srl_used=$((_srl_now - _srl_start))
		if [ "$_srl_used" -ge "$SURF_DEADLINE" ]; then
			echo "  Surfer: giving up after ${_srl_n} attempt(s) over ${_srl_used}s" >&2
			return 1
		fi
		echo "  Surfer: attempt ${_srl_n} failed (${_srl_used}s/${SURF_DEADLINE}s); retrying in ${_srl_delay}s" >&2
		# Probe the site root once, not once per attempt: on a host that is
		# already failing, extra requests only add load, and a terminal
		# 401/403 shows up on the very first failure anyway.
		if [ "$_srl_probed" -eq 0 ]; then
			_srl_probed=1
			_srl_sd=0
			surf_diagnose || _srl_sd=$?
			# Bad credentials never fix themselves; stop burning the budget.
			[ "$_srl_sd" -eq 2 ] && return 1
		fi
		sleep "$_srl_delay"
		_srl_delay=$((_srl_delay * 2))
		[ "$_srl_delay" -gt "$SURF_BACKOFF_MAX" ] && _srl_delay="$SURF_BACKOFF_MAX"
	done
}

surf_retry() {
	surf_retry_loop surf_curl "$@"
}

# MKCOL against an existing collection answers 405, which is a success for us
# but used to be retried four times (~21s of pointless waiting per arch).
surf_mkcol() {
	_SMK_URL="$1"
	surf_retry_loop surf_mkcol_try
}

surf_mkcol_try() {
	_smt_code=$(surf_curl -s -o /dev/null -w '%{http_code}' -X MKCOL "$_SMK_URL") || _smt_code=000
	case "$_smt_code" in
		200 | 201 | 204 | 301 | 405) return 0 ;;
	esac
	return 1
}

fetch_repodata() {
	_fr_url="$1"
	_fr_out="$2"
	_fr_start=$(date +%s)
	_fr_delay="$SURF_BACKOFF"
	_fr_n=0
	_fr_http=0
	_fr_probed=0
	while :; do
		_fr_n=$((_fr_n + 1))
		_fr_http=$(surf_curl -sS -o "$_fr_out" -w '%{http_code}' "$_fr_url" 2>/dev/null) || _fr_http=0
		case "$_fr_http" in
			200) return 0 ;;
			404)
				rm -f "$_fr_out"
				return 1
				;;
			0 | 429 | 5??) ;;
			*) break ;;
		esac
		_fr_now=$(date +%s)
		_fr_used=$((_fr_now - _fr_start))
		[ "$_fr_used" -ge "$SURF_DEADLINE" ] && break
		echo "  Repodata fetch returned HTTP ${_fr_http}; attempt ${_fr_n}, ${_fr_used}s/${SURF_DEADLINE}s, retrying in ${_fr_delay}s" >&2
		if [ "$_fr_probed" -eq 0 ]; then
			_fr_probed=1
			_fr_sd=0
			surf_diagnose || _fr_sd=$?
			[ "$_fr_sd" -eq 2 ] && break
		fi
		sleep "$_fr_delay"
		_fr_delay=$((_fr_delay * 2))
		[ "$_fr_delay" -gt "$SURF_BACKOFF_MAX" ] && _fr_delay="$SURF_BACKOFF_MAX"
	done
	rm -f "$_fr_out"
	echo "  Repodata fetch gave up with HTTP ${_fr_http} after ${_fr_n} attempt(s) over ${SURF_DEADLINE}s" >&2
	return 2
}

# Fatal unless both Surfer credentials are set.
surf_auth_check() {
	[ -n "${SURFER_TOKEN:-}" ] || fatal 'SURFER_TOKEN is required (Surfer >= 7: Cloudron app password)'
	[ -n "${SURFER_USER:-}" ] || fatal 'SURFER_USER is required (Surfer >= 7 rejects an empty username)'
	return 0
}

# Remove a package name so it no longer resolves from OCO. This is the safe
# way to retire a package (e.g. it was accepted upstream into void-packages):
# the entry leaves the published index without issuing a WebDAV DELETE.
#
# Why not DELETE the .xbps too? Every WebDAV DELETE crashes Surfer 7
# (webdav-server v2 dereferences a null file-system in getFileSystemPathSync
# -> uncaught TypeError -> Node exits -> Cloudron restarts -> "app is not
# responding" for minutes). The 2026-10-08 purge run proved it: the first
# orphan DELETE bounced the whole repo and the run was canceled after
# ~13 minutes of retrying against a restarting app. The .xbps staying behind
# is harmless: xbps only installs what the index advertises.
strip_orphans() {
	_orphans_list="$1"
	_repodata_file="$2"
	if [ -s "$_orphans_list" ] && [ -f "$_repodata_file" ]; then
		echo '==> Hiding orphan packages from the index (no WebDAV DELETE)'
		if ! command -v python3 >/dev/null 2>&1; then
			fatal 'python3 not found!'
		fi
		if ! xargs python3 "${REPODATA_STRIP_PY}" "$_repodata_file" < "$_orphans_list"; then
			fatal "==> repodata-strip failed; refusing to publish an index that still advertises removed packages"
		fi
		# Belt and braces: before signing + republishing, verify every orphan
		# really left the index.
		_still_present=0
		while IFS= read -r _orph; do
			[ -n "$_orph" ] || continue
			if python3 "${REPODATA_LIST_PY}" "$_repodata_file" | \
				awk -F '\t' -v p="$_orph" '$1==p {found=1} END {exit !found}' >/dev/null 2>&1; then
				echo "  ERROR: ${_orph} still present in $_repodata_file after strip" >&2
				_still_present=1
			fi
		done < "$_orphans_list"
		if [ "$_still_present" -ne 0 ]; then
			fatal "==> orphan entries still present after strip; refusing to upload ${_repodata_file}"
		fi
	fi
}

