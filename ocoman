# --- Upload ---

do_upload() {
	[ -n "$ARCH" ]         || fatal 'ARCH is required'
	surf_auth_check
	[ -n "$PRIV_KEY" ]     || fatal 'PRIV_KEY is required'

	_builddir="${BUILDDIR:-$(pwd)}"
	_webdav="${SURFER_URL}/_webdav/${ARCH}"

	_work_dir=$(mktemp -d)

	surf_mkcol "${_webdav}/" || true

	echo '==> Fetching remote package list'
	if ! _remote_list=$(fetch_remote_list "$_webdav"); then
		fatal 'PROPFIND failed; refusing to upload with unknown remote state'
	fi
	[ -z "$_remote_list" ] && echo '  Note: remote package list is empty (repo empty or first run)'

	# Run all temp-dir work in a subshell so cleanup is guaranteed on any exit.
	(
		cd "$_work_dir" || exit 1

		echo '==> Downloading repodata'
		fetch_repodata "${SURFER_URL}/${ARCH}/${ARCH}-repodata" "${ARCH}-repodata"
		case $? in
			0) ;;
			1)
				echo '==> No repodata yet (first run); starting fresh'
				;;
			*)
				fatal "==> Error: repodata fetch failed (deadline ${SURF_DEADLINE}s exhausted)"
				;;
		esac

		# xbps-src drops every architecture into one binpkgs/, so an
		# unqualified glob would republish other arches' .xbps into our
		# ${ARCH} directory. Filter on the filename's architecture suffix.
		if ls "${_builddir}"/*."${ARCH}".xbps >/dev/null 2>&1; then
			cp "${_builddir}"/*."${ARCH}".xbps . 2>/dev/null || true
			cp "${_builddir}"/*."${ARCH}".xbps.sig2 . 2>/dev/null || true

			echo '==> Cleaning old package versions from remote'
			for _new_pkg in ./*."${ARCH}".xbps; do
				[ -f "$_new_pkg" ] || continue
				_new_basename=$(basename "$_new_pkg")
				_name=$(pkg_name "${_new_basename%.xbps}")

				# Shell glob match treats '+', '.', etc. literally -- unlike grep.
				printf '%s\n' "$_remote_list" | while IFS= read -r _old_pkg; do
					case "$_old_pkg" in
						"${_name}-"[0-9]*) ;;
						*) continue ;;
					esac
					# Also reject names that share a common prefix
					# (e.g. "foo-3.0" must not match for _name="fo").
					_old_pkg_name=$(pkg_name "${_old_pkg%.xbps}")
					[ "$_old_pkg_name" = "$_name" ] || continue
					[ "$_old_pkg" = "$_new_basename" ] && continue
					echo "  Deleting old: $_old_pkg"
					delete_remote "${_webdav}/${_old_pkg}"
					delete_remote "${_webdav}/${_old_pkg}.sig2"
				done
			done
		else
			echo '==> No new packages to upload'
		fi

		prune_orphans "$_remote_list" "${PWD}/orphans.txt"
		delete_orphan_files "${PWD}/orphans.txt" "$_remote_list"

		if [ -s "${PWD}/orphans.txt" ] && [ -f "${ARCH}-repodata" ]; then
			echo '==> Stripping orphan entries from local repodata'
			if command -v python3 >/dev/null 2>&1; then
				# xargs avoids unquoted-expansion globbing on orphan names
				xargs python3 "${REPODATA_STRIP_PY}" \
					"${ARCH}-repodata" < "${PWD}/orphans.txt"
				_strip_rc=$?
			else
				fatal 'python3 not found!'
			fi
			if [ "$_strip_rc" -ne 0 ]; then
				fatal "==> repodata-strip failed; refusing to publish an index that still references deleted packages (${ARCH})"
			fi
			# Double-check in the rewritten index that every orphan is actually
			# gone before we sign + republish it. This guards against a future
			# change that strips by an inaccurate name, i.e. the exact stale
			# index (tomlplusplus adverted, .xbps gone) that broke hyprcursor.
			_still_missing=0
			while IFS= read -r _orph; do
				[ -n "$_orph" ] || continue
				if python3 "${REPODATA_LIST_PY}" "${ARCH}-repodata" | \
					awk -F '\t' -v p="$_orph" '$1==p {found=1} END {exit !found}' >/dev/null 2>&1; then
					echo "  ERROR: ${_orph} still present in ${ARCH}-repodata after strip" >&2
					_still_missing=1
				fi
			done < "${PWD}/orphans.txt"
			if [ "$_still_missing" -ne 0 ]; then
				fatal "==> orphan entries still present after strip; refusing to upload ${ARCH}-repodata"
			fi
		fi

		if ls ./*."${ARCH}".xbps >/dev/null 2>&1; then
			echo '==> Updating repository index'
			xbps-rindex -a ./*."${ARCH}".xbps 2>/dev/null || true
		fi

		echo '==> Signing repository'
		# Restrictive umask before write avoids a world-readable window
		# between create-with-default-umask and chmod 600.
		. "${SCRIPT_DIR}/src/oco-key.sh"
		oco_key_write private.pem
		xbps-rindex -s --signedby "$SIGNED_BY" --privkey private.pem "$PWD"

		if [ "$SURF_SKIP_DELETE" -eq 1 ]; then
			echo "::warning::SURF_SKIP_DELETE=1: remote .xbps deletes are disabled (Surfer 7 crashes on DELETE). Old versions and orphan binaries stay on the server but are stripped from the published index, so xbps no longer resolves them." >&2
		fi

		echo '==> Uploading packages'
		# Two phases. The remote repodata is the base index that xbps-rindex -a
		# builds on, so publishing it while a package upload is still missing
		# would leave the repo advertising a download that 404s. Packages go
		# first; the index is published only if every single one landed.
		_upload_failed=0
		for _file in ./*."${ARCH}".xbps ./*."${ARCH}".xbps.sig2; do
			[ -f "$_file" ] || continue
			_fname=$(basename "$_file")
			upload_file "$_file" "${_webdav}/${_fname}" || _upload_failed=1
		done
		if [ "$_upload_failed" -ne 0 ]; then
			fatal '==> Error: one or more package uploads failed; remote repodata left untouched'
		fi

		echo '==> Uploading repository index'
		for _file in ./*-repodata; do
			[ -f "$_file" ] || continue
			_fname=$(basename "$_file")
			upload_file "$_file" "${_webdav}/${_fname}" \
				|| fatal "==> Error: failed to upload ${_fname}"
		done

	)
	_upload_status=$?
	rm -rf "$_work_dir"
	[ "$_upload_status" -eq 0 ] || return "$_upload_status"
	echo "==> Done: ${SURFER_URL}/${ARCH}/"
}

# --- Check upstream ---

check_upstream() {
	IGNORE_FILE="${SCRIPT_DIR}/src/ignore-pkgs"
	STATE_FILE="${SCRIPT_DIR}/src/upstream-state"

	_ignores=''
	if [ -f "$IGNORE_FILE" ]; then
		_ignores=$(grep -v '^#' "$IGNORE_FILE" | grep -v '^$' || true)
	fi
	_is_ignored() {
		printf '%s\n' "$_ignores" | grep -xF "$1" >/dev/null 2>&1
	}

	_state_data=''
	[ -f "$STATE_FILE" ] && _state_data=$(cat "$STATE_FILE")

	echo '==> Fetching upstream commit feed...'
	_feed=$(curl -sS 'https://github.com/void-linux/void-packages/commits/master.atom' 2>/dev/null) || echo 'Warning: Feed fetch failed!'

	_recent=''
	if [ -n "$_feed" ]; then
		_tmp=$(mktemp)
		echo "$_feed" | awk '
			/<title>/ { if (in_title) next; in_title = 1; title = ""; next }
			/<\/title>/ {
				in_title = 0
				gsub(/^[ \t]+|[ \t]+$/, "", title)
				if (title != "" && title != "Recent Commits to void-packages:master") print title
				title = ""; next
			}
			in_title { title = title $0 }
		' 2>/dev/null | while IFS= read -r _msg; do
			[ -z "$_msg" ] && continue
			_p=$(echo "$_msg" | sed -n 's/^\([a-zA-Z0-9._+-][a-zA-Z0-9._+-]*\):.*/\1/p')
			[ -n "$_p" ] && echo "$_p"
			_p=$(echo "$_msg" | sed -n 's/^New package: \([a-zA-Z0-9._+-]*\)-.*/\1/p')
			[ -n "$_p" ] && echo "$_p"
		done > "$_tmp"
		_recent=$(sort -u "$_tmp" 2>/dev/null | tr '\n' ' ')
		rm -f "$_tmp"
	fi

	[ -n "$_recent" ] && echo "==> Recently changed upstream: $_recent" \
		|| echo '==> (no packages parsed from feed)'

	_old_state_field() {
		echo "$_state_data" | grep "^${1}|" | head -n1 | cut -d'|' -f"${2}" 2>/dev/null || true
	}

	echo ''
	echo '===================== Upstream check report ====================='
	echo ''

	_state_new=$(mktemp)
	_newer_list='' _added_list='' _up_to_date=0 _no_upstream=0 _api_calls=0

	for _d in "$SRCPKGS"/*/; do
		[ -d "$_d" ] || continue
		_pkg=${_d%/}; _pkg=${_pkg##*/}

		_is_ignored "$_pkg" && {
			printf '%s|ignored||ignored\n' "$_pkg" >> "$_state_new"
			continue
		}

		_local_ver=$(grep '^version=' "$_d/template" 2>/dev/null \
			| head -n1 | cut -d= -f2- | tr -d '"' | tr -d ' ')
		[ -z "$_local_ver" ] && _local_ver='?'

		_old_exists=$(_old_state_field "$_pkg" 2)
		_old_ver=$(_old_state_field "$_pkg" 3)

		_fetch=false
		case " $_recent " in *" $_pkg "*) _fetch=true ;; esac
		[ -z "$_old_exists" ] && _fetch=true
		[ "$_old_exists" = 'ignored' ] && _fetch=true

		if $_fetch; then
			_up_template=$(curl -sf \
				"https://raw.githubusercontent.com/void-linux/void-packages/master/srcpkgs/${_pkg}/template" \
				2>/dev/null) || true
			_api_calls=$((_api_calls + 1))
			if [ -n "$_up_template" ]; then
				_up_ver=$(echo "$_up_template" | grep '^version=' | head -n1 \
					| cut -d= -f2- | tr -d '"' | tr -d ' ')
				_up_exists='yes'
			else
				_up_exists='no'
				_up_ver=''
			fi
		else
			_up_exists="$_old_exists"
			_up_ver="$_old_ver"
		fi

		if [ "$_up_exists" = 'yes' ] && [ -n "$_up_ver" ] && [ "$_local_ver" != "?" ]; then
			if [ "$_up_ver" != "$_local_ver" ]; then
				_lower=$(printf '%s\n%s' "$_up_ver" "$_local_ver" \
					| sort -V 2>/dev/null | head -n1)
				[ "$_lower" = "$_local_ver" ] && _newer_list="$_newer_list $_pkg"
			fi
		fi

		_status='current'
		if [ "$_up_exists" = 'yes' ] && [ "$_old_exists" = 'no' ]; then
			_status='suggested_removal'
			_added_list="$_added_list $_pkg"
		fi

		if [ "$_up_exists" = 'yes' ]; then
			_up_to_date=$((_up_to_date + 1))
		elif [ "$_up_exists" = 'no' ]; then
			_no_upstream=$((_no_upstream + 1))
		fi

		printf '%s|%s|%s|%s\n' "$_pkg" "$_up_exists" "$_up_ver" "$_status" \
			>> "$_state_new"
	done

	# shellcheck disable=SC2086
	_ncnt=$(echo $_newer_list | wc -w | tr -d ' ')
	# shellcheck disable=SC2086
	_acnt=$(echo $_added_list | wc -w | tr -d ' ')
	_icnt=$(grep -c '|ignored|' "$_state_new" 2>/dev/null) || _icnt=0

	if [ "$_ncnt" -gt 0 ]; then
		echo ''
		for _p in $_newer_list; do
			_nv=$(grep "^${_p}|" "$_state_new" | head -n1 | cut -d'|' -f3)
			_lv=$(grep '^version=' "$SRCPKGS/$_p/template" 2>/dev/null \
				| head -n1 | cut -d= -f2- | tr -d '"' | tr -d ' ')
			printf '  '; _y "[NEWER] $_p: $_lv -> $_nv"
		done
	fi

	if [ "$_acnt" -gt 0 ]; then
		echo ''
		for _p in $_added_list; do
			_nv=$(grep "^${_p}|" "$_state_new" | head -n1 | cut -d'|' -f3)
			printf '  '; _r "[ADDED] $_p (v$_nv) -- now exist in Void Linux!"
			echo "         -> rm -rf srcpkgs/$_p/"
			echo "         -> git rm srcpkgs/$_p/"
		done
	fi

	echo ''
	echo '================================================================='
	echo ''
	[ "$_ncnt" -gt 0 ] && printf '  %bNEWER%b:     %s\n' "$YELLOW" "$NC" "$_newer_list"
	[ "$_acnt" -gt 0 ] && printf '  %bADDED%b:     %s\n' "$RED" "$NC" "$_added_list"
	[ "$_icnt" -gt 0 ] && echo "  IGNORED:   $_icnt packages"
	echo "  No change: $_up_to_date in repo, $_no_upstream not in Void Linux"
	echo "  API calls: $_api_calls"

	mv "$_state_new" "$STATE_FILE"
	echo ''
	_g "State saved to $STATE_FILE"
}

# --- Init / clone ---

_clone_repo() {
	_cr_name="$1" _cr_url="$2" _cr_dest="$3"
	echo "==> Cloning ${_cr_name} ..."
	if [ -n "$CLONE_DEPTH" ]; then
		git clone --depth "$CLONE_DEPTH" "$_cr_url" "$_cr_dest" || fatal "cloning ${_cr_name} failed"
	else
		git clone "$_cr_url" "$_cr_dest" || fatal "cloning ${_cr_name} failed"
	fi
}

do_init() {
	# Clone void-packages directly to destination
	rm -rf "$CLONE_DEST"
	_clone_repo 'void-packages' "$VOID_URL" "$CLONE_DEST"

	# Set up remotes
	echo '==> Setting up remotes ...'
	git -C "$CLONE_DEST" remote rename origin void || fatal 'Failed to rename remote!'
	git -C "$CLONE_DEST" branch --set-upstream-to=void/master master
	git -C "$CLONE_DEST" remote add OCO "$OCO_URL"

	# Create OCO branch from the actual OCO remote
	echo "==> Fetching OCO and creating ${OCO_BRANCH} branch ..."
	git -C "$CLONE_DEST" fetch OCO
	git -C "$CLONE_DEST" checkout -b "$OCO_BRANCH" --track "OCO/${OCO_BRANCH}" \
		|| fatal "failed to create ${OCO_BRANCH} branch"

	git -C "$CLONE_DEST" checkout master

	# Overlay OCO files onto master (untracked) via git archive — skips .gitignore
	echo '==> Overlaying OCO files onto master ...'
	git -C "$CLONE_DEST" archive "OCO/${OCO_BRANCH}" \
		| tar -x -C "$CLONE_DEST" --exclude='.gitignore'

	# Apply shlibs on master
	do_shlibs

	echo '==> Initializing masterdir ...'
	"${CLONE_DEST}/xbps-src" binary-bootstrap || fatal 'Binary-bootstrap failed!'

	_g "==> Done: ${CLONE_DEST}"
	_g '    master  → void/master (void-packages)'
	_g "    ${OCO_BRANCH}      → OCO/${OCO_BRANCH}"
}

# --- Shlibs ---

_shlibs_remove() {
	_shlibs=$1 _removefile=$2 _line=''
	echo '==> Removing shlibs entries'
	while IFS= read -r _line; do
		[ -z "$_line" ] && continue
		grep -vF "$_line" "$_shlibs" > "${_shlibs}.tmp" \
			&& mv "${_shlibs}.tmp" "$_shlibs"
		echo "   - $_line"
	done < "$_removefile"
}

_shlibs_append() {
	_shlibs=$1 _appendfile=$2 _line=''
	echo '==> Adding shlibs entries'
	while IFS= read -r _line; do
		[ -z "$_line" ] && continue
		if ! grep -qF "$_line" "$_shlibs"; then
			echo "$_line" >> "$_shlibs"
			echo "   + $_line"
		fi
	done < "$_appendfile"
}

do_add_oco() {
	echo '==> Adding OCO remote ...'
	git -C "$CLONE_DEST" remote add OCO "$OCO_URL" || fatal 'OCO remote already exists, or other problem!'
	git -C "$CLONE_DEST" fetch OCO
	echo "==> Creating ${OCO_BRANCH} branch from OCO/${OCO_BRANCH} ..."
	git -C "$CLONE_DEST" checkout -b "$OCO_BRANCH" --track "OCO/${OCO_BRANCH}" \
		|| fatal "Failed to create branch ${OCO_BRANCH}!"
	git -C "$CLONE_DEST" checkout -
}

_pkg_version() {
	grep '^version=' "${CLONE_DEST}/srcpkgs/${1}/template" 2>/dev/null \
		| head -n1 | cut -d= -f2- | tr -d '"'
}

do_to_void() {
	[ $# -gt 0 ] || fatal 'Usage: ocoman to-void <package...>'
	for _pkg in "$@"; do
		git -C "$CLONE_DEST" checkout "$OCO_BRANCH" -- "srcpkgs/${_pkg}/" \
			|| { _g "  skipping ${_pkg} (not found in ${OCO_BRANCH})"; continue; }
		_ver=$(_pkg_version "$_pkg")
		git -C "$CLONE_DEST" commit -m "New package: ${_pkg}-${_ver}"
	done
}

do_to_oco() {
	[ $# -gt 0 ] || fatal 'usage: ocoman to-oco <package...>'
	for _pkg in "$@"; do
		git -C "$CLONE_DEST" checkout master -- "srcpkgs/${_pkg}/" \
			|| { _g "  skipping ${_pkg} (not found in master)"; continue; }
		_ver=$(_pkg_version "$_pkg")
		git -C "$CLONE_DEST" commit -m "${_pkg} ${_ver}"
	done
}

do_shlibs() {
	[ -f "$SHLIBS_FILE" ] || fatal "shlibs file not found: ${SHLIBS_FILE}"
	[ -f "$SHLIBS_REMOVE" ] && _shlibs_remove "$SHLIBS_FILE" "$SHLIBS_REMOVE"
	[ -f "$SHLIBS_APPEND" ] && _shlibs_append "$SHLIBS_FILE" "$SHLIBS_APPEND"
}

# --- Test in CI ---

_all_templates() {
	find "${SCRIPT_DIR}/${SRCPKGS}" -maxdepth 1 -mindepth 1 -type d -printf '%f\n' 2>/dev/null | sort -f
}

_gh_repo_slug() {
	_url=$(git -C "$SCRIPT_DIR" remote get-url gh 2>/dev/null || printf '%s' "$CI_URL")
	_slug=${_url#*github.com/}
	_slug=${_slug#*:}
	_slug=${_slug%.git}
	_slug=${_slug%/}
	printf '%s' "$_slug"
}

do_test() {
	command -v gh >/dev/null 2>&1 || fatal 'gh CLI is required: https://cli.github.com/'

	_repo=$(_gh_repo_slug)
	[ -n "$_repo" ] || fatal 'could not determine GitHub repository (add the "gh" git remote)'
	_ref="${TEST_REF:-$(git -C "$SCRIPT_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo OCO)}"

	_runner='auto'
	_pkgs=''

	if [ $# -gt 0 ]; then
		for _p in "$@"; do
			[ -d "${SCRIPT_DIR}/${SRCPKGS}/${_p}" ] || fatal "template not found: ${_p}"
		done
		_pkgs="$*"
	else
		command -v gum >/dev/null 2>&1 \
			|| fatal 'gum is required for the interactive picker: https://github.com/charmbracelet/gum'

		_mode=$(printf '%s\n' 'Single template' 'Multiple templates' \
			| gum filter --reverse --limit 1 --header 'Selection mode?') \
			|| { _y 'Aborted'; return 1; }

		_runner=$(printf '%s\n' auto amd64 arm64 nativ self-hosted \
			| gum filter --reverse --limit 1 --header 'Runner?' --selected auto) \
			|| { _y 'Aborted'; return 1; }

		_tpls=$(_all_templates)
		[ -n "$_tpls" ] || fatal 'no templates found in srcpkgs'

		case "$_mode" in
			'Multiple templates')
				_pkgs=$(printf '%s\n' "$_tpls" \
					| gum filter --reverse --no-limit --height 15 \
						--header 'Select templates (type to filter, Tab toggles, Enter confirms)') \
					|| { _y 'Aborted'; return 1; }
				;;
			*)
				_pkgs=$(printf '%s\n' "$_tpls" \
					| gum filter --reverse --limit 1 --header 'Select a template') \
					|| { _y 'Aborted'; return 1; }
				;;
		esac

		_pkgs=$(printf '%s\n' "$_pkgs" | grep -v '^$' | tr '\n' ' ' | sed 's/ $//')
		[ -n "$_pkgs" ] || { _r 'No templates selected; aborting'; return 1; }
	fi

	echo ''
	_b '==> Dispatching CI build on GitHub'
	echo "  Repository: $_repo"
	echo "  Branch:     $_ref"
	[ "$_runner" != 'auto' ] && echo "  Runner:     $_runner"
	echo "  Templates:  $_pkgs"
	echo ''

	gh workflow run build.yml --repo "$_repo" --ref "$_ref" -f "runner=$_runner" -f "templates=$_pkgs"
	[ $? -eq 0 ] || fatal 'failed to dispatch workflow (check gh auth / permissions)'

	_run_id=$(gh run list --workflow=build.yml --branch "$_ref" --limit 1 \
		--json databaseId --jq '.[0].databaseId' 2>/dev/null || true)
	_g '==> CI build dispatched'
	if [ -n "$_run_id" ]; then
		_y "    Run:     https://github.com/${_repo}/actions/runs/${_run_id}"
		echo "    Watch:   gh run watch $_run_id --repo $_repo"
	else
		echo '    See:   gh run list --workflow build.yml'
	fi
}

do_autobump() {
	command -v gh >/dev/null 2>&1 || fatal 'gh CLI is required: https://cli.github.com/'
	command -v gum >/dev/null 2>&1 \
		|| fatal 'gum is required for the interactive picker: https://github.com/charmbracelet/gum'

	_repo=$(_gh_repo_slug)
	[ -n "$_repo" ] || fatal 'could not determine GitHub repository (add the "gh" git remote)'
	_ref="${TEST_REF:-$(git -C "$SCRIPT_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo OCO)}"

	_pkg=''
	_force=0
	for _a in "$@"; do
		case "$_a" in
			--force|-f) _force=1 ;;
			-*) fatal "unknown option: $_a" ;;
			*) [ -n "$_pkg" ] && fatal "only one package allowed: $_a"; _pkg="$_a" ;;
		esac
	done

	if [ -z "$_pkg" ]; then
		_tpls=$(_all_templates)
		[ -n "$_tpls" ] || fatal 'no templates found in srcpkgs'
		_pkg=$(printf '%s\n' "$_tpls" \
			| gum filter --reverse --limit 1 --header 'Select a template to autobump') \
			|| { _y 'Aborted'; return 1; }
	fi
	[ -d "${SCRIPT_DIR}/${SRCPKGS}/${_pkg}" ] || fatal "template not found: ${_pkg}"

	echo ''
	_b '==> Dispatching autobump on GitHub'
	echo "  Repository: $_repo"
	echo "  Branch:     $_ref"
	echo "  Package:    $_pkg"
	[ "$_force" = 1 ] && echo '  Force:      yes (ignore src/autobump-pkgs whitelist)'
	echo ''

	if [ "$_force" = 1 ]; then
		gh workflow run autobump.yml --repo "$_repo" --ref "$_ref" \
			-f "pkg=$_pkg" -f "force=true"
	else
		gh workflow run autobump.yml --repo "$_repo" --ref "$_ref" \
			-f "pkg=$_pkg"
	fi
	[ $? -eq 0 ] || fatal 'failed to dispatch workflow (check gh auth / permissions)'

	_run_id=$(gh run list --workflow=autobump.yml --branch "$_ref" --limit 1 \
		--json databaseId --jq '.[0].databaseId' 2>/dev/null || true)
	_g '==> Autobump dispatched'
	if [ -n "$_run_id" ]; then
		_y "    Run:     https://github.com/${_repo}/actions/runs/${_run_id}"
		echo "    Watch:   gh run watch $_run_id --repo $_repo"
	else
		echo '    See:   gh run list --workflow autobump.yml'
	fi
}

# --- Main ---

main() {
	case "${1:-}" in
		help|--help)          set -- -h ;;
		update)               set -- -u ;;
		build|web)            set -- -w ;;
		main)                 set -- -m ;;
		upload|publish)       set -- -p ;;
		serve)                set -- -s ;;
		archs)                set -- -a ;;
		check-upstream|check) set -- -c ;;
		init|setup)           set -- -i ;;
		add-oco)              set -- -o ;;
		to-void)              shift; do_to_void "$@"; return 0 ;;
		to-oco)               shift; do_to_oco "$@"; return 0 ;;
		autobump)             shift; do_autobump "$@"; return 0 ;;
		shlibs)               set -- -l ;;
		test)                 shift; set -- -t "$@" ;;
	esac

	_opt='' OPTIND=1 OPTARG=''
	_do_update='' _do_packages='' _do_web='' _do_main='' _do_archs='' _do_check=''
	_do_init='' _do_add_oco='' _do_shlibs='' _do_test=''
	while getopts 'huwmpsaciolt' _opt; do
		case "$_opt" in
			h) usage; return 0 ;;
			u) _do_update=1 ;;
			w) _do_web=1 ;;
			m) _do_main=1 ;;
			p) _do_packages=1 ;;
			s) target_serve; return 0 ;;
			a) _do_archs=1 ;;
			c) _do_check=1 ;;
			i) _do_init=1 ;;
			o) _do_add_oco=1 ;;
			l) _do_shlibs=1 ;;
			t) _do_test=1 ;;
			*) usage >&2; return 1 ;;
		esac
	done

	[ -n "$_do_update$_do_packages$_do_web$_do_main$_do_archs$_do_check$_do_init$_do_add_oco$_do_shlibs$_do_test" ] ||
		{ usage >&2; return 1; }

	if [ "$_do_update" = 1 ] || [ "$_do_web" = 1 ] || [ "$_do_main" = 1 ] || [ "$_do_check" = 1 ] \
			|| [ "$_do_test" = 1 ]; then
		[ -d "$SRCPKGS" ] || fatal "srcpkgs directory not found: ${SRCPKGS}"
	fi

	if [ "$_do_test" = 1 ]; then
		shift $((OPTIND - 1))
		do_test "$@"
		return $?
	fi

	if [ "$_do_init" = 1 ]; then
		do_init
	fi
	if [ "$_do_add_oco" = 1 ]; then
		do_add_oco
	fi
	if [ "$_do_shlibs" = 1 ]; then
		do_shlibs
	fi
	if [ "$_do_update" = 1 ]; then
		[ -f "$README" ] || fatal "README not found: ${README}"
		generate_list
		generate_readme
		generate_build_yml
		detect_changes
		suggest_feeds
	fi
	if [ "$_do_web" = 1 ]; then
		build_site
	fi
	if [ "$_do_main" = 1 ] && [ "$_do_web" != 1 ]; then
		build_main
	fi
	if [ "$_do_archs" = 1 ] && [ "$_do_web" != 1 ]; then
		generate_arch_pages
	fi
	if [ "$_do_check" = 1 ]; then
		check_upstream
	fi
	if [ "$_do_packages" = 1 ]; then
		do_upload
	fi
}

main "$@"
