VOID_URL='https://github.com/void-linux/void-packages'
OCO_URL='https://codeberg.org/oSoWoSo/oco'
CLONE_DEST="${CLONE_DEST:-$HOME/void}"
CLONE_TEMP="${CLONE_TEMP:-/tmp}"
CLONE_DEPTH="${CLONE_DEPTH:-}"
OCO_BRANCH="${OCO_BRANCH:-OCO}"

# --- Shlibs (env-overridable) ---
SHLIBS_FILE="${SHLIBS_FILE:-${CLONE_DEST}/common/shlibs}"
