# Pin collation so sort output is identical on CI (C locale) and local
export LC_ALL=C
SCRIPT_DIR=$(cd -- "$(dirname -- "$0")" && pwd)
echo "SCRIPT_DIR = $SCRIPT_DIR"
# shellcheck source=/dev/null
[ -f "${SCRIPT_DIR}/.env" ] && . "${SCRIPT_DIR}/.env"

# --- Repo management ---
SRCPKGS='srcpkgs'
TEMPLATES_LIST='/tmp/oco-templates-list'
REPODATA_LIST_PY="${SCRIPT_DIR}/src/repodata-list.py"
REPODATA_STRIP_PY="${SCRIPT_DIR}/src/repodata-strip.py"
BUILD_TEMPLATE="${SCRIPT_DIR}/src/build.yml.in"
README="${SCRIPT_DIR}/README.md"
WORKFLOW="${SCRIPT_DIR}/.github/workflows/build.yml"
FEED_OPML="${SCRIPT_DIR}/src/feed.opml"
NVCONF="${SCRIPT_DIR}/.nvchecker/nvchecker.toml"

SURFER_URL='https://repo.osowoso.org'
# Surfer >= 7.0: API tokens are deprecated -- use a Cloudron app password
# together with a non-empty username (an empty one is rejected outright).
SURFER_USER="${SURFER_USER:-}"
# Deprecated, kept only so existing callers keep working: retries are now
# bounded by SURF_DEADLINE wall-clock, not by an attempt count.
SURF_ATTEMPTS="${SURF_ATTEMPTS:-4}"
# Initial retry delay; doubles each attempt, capped by SURF_BACKOFF_MAX.
SURF_BACKOFF="${SURF_BACKOFF:-3}"
# Wall-clock budget for a single retried request, replacing the old fixed
# SURF_ATTEMPTS count: a 2026-09-27 outage lasted ~16 minutes, so a fixed
# attempt count is not a meaningful safety net.
SURF_DEADLINE="${SURF_DEADLINE:-1500}"
# Never wait on a dead socket; but do not cap a package upload, which may
# legitimately take minutes and must not be truncated mid-PUT.
SURF_CONNECT_TIMEOUT="${SURF_CONNECT_TIMEOUT:-20}"
SURF_MAX_TIME="${SURF_MAX_TIME:-300}"
SURF_BACKOFF_MAX="${SURF_BACKOFF_MAX:-30}"
# Surfer 7 ships webdav-server v2, where every WebDAV DELETE kills the app:
# Surfer's SiteFileSystem is not registered in server.fileSystems, so
# getFileSystemPathSync() returns null and FileSystem.js:1289 dereferences it
# (`fsPath.getChildPath(path)`) -> uncaught TypeError -> Node exits ->
# Cloudron restarts -> nginx serves "app is not responding" (HTTP 502) for
# every request in that window. Retrying cannot fix it: the next DELETE
# crashes the app again. Hence deletions are opt-in.
SURF_SKIP_DELETE="${SURF_SKIP_DELETE:-1}"
# Orphans (packages with no template in srcpkgs/) are ALWAYS stripped from the
# published index -- that is what makes xbps stop resolving them -- but the
# leftover .xbps binary is only deleted when this is explicitly enabled. The
# default follows the known DELETE crash above: hide, never touch the file.
SURF_DELETE_ORPHANS="${SURF_DELETE_ORPHANS:-0}"
CI_URL="${CI_URL:-https://github.com/oSoWoSo/Void_Community_Repository}"
SIGNED_BY='oSoWoSo <mail@osowoso.org>'
ARCHES='x86_64 x86_64-musl aarch64 aarch64-musl'

# shellcheck source=src/pkg-helpers.sh
. "${SCRIPT_DIR}/src/pkg-helpers.sh"

